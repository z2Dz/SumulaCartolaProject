@* Componentes/InstalarApp.razor *@
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (visivel)
{
    <div class="instalar-fundo" @onclick="Depois">
        <div class="instalar-caixa" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="instalar-titulo">
            <img class="instalar-icone" src="icons/icon-192.png" alt="" />
            <h2 id="instalar-titulo">Instalar o Cartola dos Amigos?</h2>

            @if (ios)
            {
                <p>Para abrir como app, toque em <strong>Compartilhar</strong> (o quadrado com a seta para cima) e depois em <strong>Adicionar à Tela de Início</strong>.</p>
            }
            else
            {
                <p>Instale na tela inicial do celular para abrir mais rápido e em tela cheia.</p>
            }

            <div class="instalar-botoes">
                @if (!ios)
                {
                    <button type="button" class="instalar-sim" @onclick="Instalar">Instalar</button>
                }
                <button type="button" class="instalar-nao" @onclick="Depois">@(ios ? "Entendi" : "Agora não")</button>
            </div>
        </div>
    </div>
}

<style>
    .instalar-fundo {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        background: rgba(0, 0, 0, .6);
        padding: 16px;
        padding-bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    }

    .instalar-caixa {
        width: 100%;
        max-width: 380px;
        text-align: center;
        background: #0b3d2e;
        color: #fff;
        border-radius: 20px;
        padding: 24px 20px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, .5);
        font-family: inherit;
    }

    .instalar-icone {
        width: 64px;
        height: 64px;
        border-radius: 16px;
        margin-bottom: 12px;
    }

    .instalar-caixa h2 {
        margin: 0 0 8px;
        font-size: 1.15rem;
    }

    .instalar-caixa p {
        margin: 0 0 18px;
        font-size: .95rem;
        line-height: 1.4;
        opacity: .9;
    }

    .instalar-botoes {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .instalar-botoes button {
            border: 0;
            border-radius: 999px;
            padding: 12px 16px;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            font-family: inherit;
        }

    .instalar-sim {
        background: #f5c518;
        color: #0b3d2e;
    }

    .instalar-nao {
        background: transparent;
        color: #fff;
        opacity: .8;
    }
</style>

@code {
    /// <summary>Avisa o layout quando o app pode (ou deixa de poder) ser instalado, para mostrar o botão do menu.</summary>
    [Parameter] public EventCallback<bool> DisponivelMudou { get; set; }

    private IJSObjectReference? modulo;
    private bool visivel;
    private bool ios;
    private DotNetObjectReference<InstalarApp>? referencia;

    /// <summary>Abre o convite de instalação sob demanda (botão do menu).</summary>
    public void Abrir()
    {
        visivel = true;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            modulo = await JS.InvokeAsync<IJSObjectReference>("import", "./js/instalar.js");

            if (await modulo.InvokeAsync<bool>("jaInstalado")) return;

            referencia = DotNetObjectReference.Create(this);
            await modulo.InvokeVoidAsync("observarInstalacao", referencia);

            ios = await modulo.InvokeAsync<bool>("ehIos");

            // No Android, só dá para instalar se o navegador liberou a instalação (espera até 4 s).
            if (!ios && !await modulo.InvokeAsync<bool>("podeInstalar", 4000)) return;

            await DisponivelMudou.InvokeAsync(true);

            // Convite automático: respeita o adiamento e só aparece depois do tutorial.
            if (await modulo.InvokeAsync<bool>("adiadoRecente")) return;
            if (await JS.InvokeAsync<string?>("localStorage.getItem", "tutorial-visto") != "1") return;

            visivel = true;
            StateHasChanged();
        }
        catch
        {
            // Se algo falhar, simplesmente não mostra o convite.
        }
    }

    private async Task Instalar()
    {
        visivel = false;
        if (modulo is not null)
        {
            var resultado = await modulo.InvokeAsync<string>("instalar");
            if (resultado == "dismissed") await modulo.InvokeVoidAsync("adiar");

            // O navegador só aceita um pedido de instalação por carregamento da página.
            if (!ios) await DisponivelMudou.InvokeAsync(false);
        }
    }

    /// <summary>Chamado pelo navegador quando o app é instalado, por qualquer caminho.</summary>
    [JSInvokable]
    public async Task AoInstalado()
    {
        visivel = false;
        StateHasChanged();
        await DisponivelMudou.InvokeAsync(false);
    }

    private async Task Depois()
    {
        visivel = false;
        if (modulo is not null) await modulo.InvokeVoidAsync("adiar");
    }

    public async ValueTask DisposeAsync()
    {
        if (modulo is not null)
        {
            try { await modulo.InvokeVoidAsync("pararObservacao"); } catch { }
            try { await modulo.DisposeAsync(); } catch { }
        }
        referencia?.Dispose();
    }
}
