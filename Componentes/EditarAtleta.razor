@inject ServicoSumula Servico

@* Cria ou edita um atleta. Atleta nulo = atleta novo (não entra em nenhuma chegada).
   MostrarAtivo liga o seletor Ativo / Não ativo no Cartola. *@
<div class="previa-fundo" @onclick="Fechar">
    <div class="previa" role="dialog" aria-modal="true" aria-label="@Titulo" @onclick:stopPropagation="true">
        <div class="previa-topo">
            <h3>@Titulo</h3>
            <button type="button" class="adm-icone" @onclick="Fechar" aria-label="Fechar">✕</button>
        </div>

        @if (!string.IsNullOrEmpty(erro)) { <p class="erro">@erro</p> }

        <div class="chg-rola">
            <label class="adm-rotulo" for="editar-nome">Nome</label>
            <input id="editar-nome" class="adm-campo" @bind="nome" @bind:event="oninput" maxlength="40" autocomplete="off" />

            <span class="adm-rotulo">Posições que joga</span>
            <div class="adm-chips">
                @foreach (var (sigla, rotulo) in PosicoesAtleta.Todas)
                {
                    var s = sigla;
                    <button type="button" class="adm-chip @(posicoes.Contains(s) ? "on" : "")" aria-pressed="@posicoes.Contains(s)"
                            @onclick="() => Alternar(s)">@sigla <small>@rotulo</small></button>
                }
            </div>

            <span class="adm-rotulo">Foto</span>
            <SeletorFoto Nome="@nome" FotoUrlAtual="@Atleta?.FotoUrl" Posicoes="@posicoes" Tamanho="72"
                         @bind-Foto="fotoBytes" @bind-Removida="removerFoto" />

            @if (MostrarAtivo)
            {
                <div class="cartola-status adm-topo-gap">
                    <div class="cartola-status-info">
                        <strong>Ativo para o Cartola</strong>
                        <small>@(ativo ? "Aparece no mercado para os usuários escalarem." : "Não aparece no mercado para os usuários escalarem.")</small>
                    </div>
                    <div class="cartola-seg" role="radiogroup" aria-label="Ativo para o Cartola">
                        <button type="button" role="radio" aria-checked="@ativo" class="@(ativo ? "sel" : "")" @onclick="() => ativo = true">Ativo</button>
                        <button type="button" role="radio" aria-checked="@(!ativo)" class="@(!ativo ? "sel" : "")" @onclick="() => ativo = false">Não ativo</button>
                    </div>
                </div>
            }

            <button type="button" class="botao adm-topo-gap" disabled="@salvando" @onclick="Salvar">
                @(salvando ? "Salvando…" : (Atleta is null ? "Cadastrar atleta" : "Salvar alterações"))
            </button>
        </div>
    </div>
</div>

@code {
    /// <summary>Atleta a editar. Nulo cria um atleta novo.</summary>
    [Parameter] public AtletaResumo? Atleta { get; set; }
    [Parameter] public bool MostrarAtivo { get; set; }
    [Parameter] public EventCallback<AtletaResumo> OnSalvo { get; set; }
    [Parameter] public EventCallback OnFechar { get; set; }

    private string nome = "";
    private HashSet<string> posicoes = new();
    private byte[]? fotoBytes;
    private string? erro;
    private bool removerFoto, salvando, ativo = true;

    private string Titulo => Atleta is null ? "Novo atleta" : "Editar atleta";

    protected override void OnInitialized()
    {
        if (Atleta is null) { ativo = false; return; }   // atleta novo começa fora do mercado
        nome = Atleta.Nome;
        posicoes = new HashSet<string>(Atleta.Posicoes);
        ativo = Atleta.Ativo;
    }

    private Task Fechar() => OnFechar.InvokeAsync();

    private void Alternar(string sigla)
    {
        if (!posicoes.Remove(sigla)) posicoes.Add(sigla);
    }

    private async Task Salvar()
    {
        erro = null;
        if (string.IsNullOrWhiteSpace(nome)) { erro = "Informe o nome do atleta."; return; }
        if (posicoes.Count == 0) { erro = "Escolha ao menos uma posição."; return; }

        salvando = true;
        try
        {
            string? url = fotoBytes is null ? null : await Servico.EnviarFotoAsync(fotoBytes);
            var ordenadas = PosicoesAtleta.Todas.Select(p => p.Sigla).Where(posicoes.Contains).ToList();

            var resultado = Atleta is null
                ? await Servico.RegistrarAtletaAsync(nome.Trim(), ordenadas, url, ativo)
                : await Servico.EditarAtletaAsync(Atleta.Id, nome.Trim(), ordenadas, url, removerFoto && url is null,
                                                  MostrarAtivo ? ativo : null);
            await OnSalvo.InvokeAsync(resultado);
        }
        catch (ErroAdminException ex) { erro = ex.Message; }
        salvando = false;
    }
}
