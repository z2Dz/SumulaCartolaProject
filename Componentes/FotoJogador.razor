@implements IDisposable
@using SumulaCartolaProject.Servicos
@inject ServicoZoomFoto Zoom
@if (!string.IsNullOrWhiteSpace(FotoUrl))
{
  <span style="position:relative;display:inline-block;line-height:0">
    @if (Ampliavel)
    {
        @* Segurar a foto (mouse ou toque) abre o zoom, que fica na tela até o usuário fechar (ver ZoomFotoHost). *@
        <img class="foto" src="@FotoUrl" alt="@Nome" loading="lazy" draggable="false"
             style="width:@(Tamanho)px;height:@(Tamanho)px;-webkit-touch-callout:none;-webkit-user-select:none;user-select:none"
             @onpointerdown="Segurar" @onpointerup="Soltar" @onpointerleave="Soltar" @onpointercancel="Soltar"
             @oncontextmenu="Ignorar" @oncontextmenu:preventDefault="true" @onclick:stopPropagation="@suprimirClique" />
    }
    else
    {
        <img class="foto" src="@FotoUrl" alt="@Nome" style="width:@(Tamanho)px;height:@(Tamanho)px" loading="lazy" />
    }
    @if (Editavel)
    {
        @* Só aparece para quem já tem foto: reabre o recorte (com remover fundo/borda) sobre a foto atual. *@
        <button type="button" class="foto-editar" title="Editar foto" aria-label="Editar foto de @Nome"
                style="position:absolute;right:-2px;bottom:-2px;width:@(BotaoEditar)px;height:@(BotaoEditar)px;padding:0;border:2px solid #fff;border-radius:50%;background:#1f6feb;color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;line-height:1"
                @onclick="Editar" @onclick:stopPropagation="true" @onpointerdown:stopPropagation="true">
            <svg viewBox="0 0 24 24" width="@(BotaoEditar - 8)" height="@(BotaoEditar - 8)" fill="currentColor" aria-hidden="true" focusable="false">
                <path d="M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 0 0 0-1.41l-2.34-2.34a1 1 0 0 0-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z" />
            </svg>
        </button>
    }
  </span>
}
else
{
    <span class="foto foto-sil" aria-hidden="true"
          style="width:@(Tamanho)px;height:@(Tamanho)px;background:hsl(@Matiz 40% 30%)">
        <SilhuetaAtleta Sigla="@SiglaEfetiva" Nome="@Nome" />
    </span>
}

@code {
    [Parameter, EditorRequired] public string Nome { get; set; } = "";
    [Parameter] public string? FotoUrl { get; set; }
    [Parameter] public int Tamanho { get; set; } = 46;
    /// <summary>Posições do atleta (GOL, LAT...). A primeira define a silhueta.</summary>
    [Parameter] public IEnumerable<string>? Posicoes { get; set; }
    /// <summary>Posição fixa, quando o contexto já sabe qual é. Tem prioridade sobre Posicoes.</summary>
    [Parameter] public string? Posicao { get; set; }
    /// <summary>Segurar a foto abre o zoom, que só fecha quando o usuário pedir. Desligado por padrão para não mudar os outros usos.</summary>
    [Parameter] public bool Ampliavel { get; set; }
    /// <summary>Mostra o botão "editar foto" quando o jogador já tem foto. Desligado por padrão.</summary>
    [Parameter] public bool Editavel { get; set; }
    /// <summary>Disparado ao clicar em editar; quem usa o componente abre o recorte com a foto atual.</summary>
    [Parameter] public EventCallback OnEditar { get; set; }

    private int BotaoEditar => Math.Clamp(Tamanho / 3, 20, 28);
    private Task Editar() => OnEditar.InvokeAsync();

    private const int TempoSegurarMs = 350;
    private bool suprimirClique;   // o clique logo após soltar a foto não deve acionar o card onde ela está
    private bool descartado;
    private CancellationTokenSource? segurando;

    private string? SiglaEfetiva => Posicao ?? Posicoes?.FirstOrDefault();

    // Cor de fundo estável por nome, para os avatares não ficarem todos iguais
    private int Matiz => Math.Abs(Nome.Aggregate(7, (h, c) => h * 31 + c)) % 360;

    private async Task Segurar(PointerEventArgs e)
    {
        if (e.Button != 0 || string.IsNullOrWhiteSpace(FotoUrl)) return;
        CancelarSegurar();
        suprimirClique = false;
        var cts = segurando = new CancellationTokenSource();
        try { await Task.Delay(TempoSegurarMs, cts.Token); }
        catch (TaskCanceledException) { return; }
        suprimirClique = true;
        Zoom.Abrir(Nome, FotoUrl!);
    }

    private void Soltar()
    {
        CancelarSegurar();
        if (suprimirClique) _ = LiberarCliqueDepois();
    }

    private async Task LiberarCliqueDepois()
    {
        await Task.Delay(350);
        suprimirClique = false;
        if (!descartado) await InvokeAsync(StateHasChanged);
    }

    // o menu de contexto (segurar no celular / botão direito) cancelaria o toque; um handler real garante o preventDefault
    private void Ignorar() { }

    private void CancelarSegurar()
    {
        segurando?.Cancel();
        segurando?.Dispose();
        segurando = null;
    }

    public void Dispose()
    {
        descartado = true;
        CancelarSegurar();
    }
}
