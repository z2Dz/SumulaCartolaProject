@implements IDisposable
@* Miniatura redonda do atleta (listas): foto com aro branco, igual à do campo, ou a silhueta da posição.
   Segurar a foto (mouse ou toque) amplia ela na tela; soltar fecha. Vale em todas as listas que usam este componente. *@
@if (!string.IsNullOrWhiteSpace(Atleta.FotoUrl))
{
    <img class="foto-redonda" style="--d:@(Diametro)px" src="@Atleta.FotoUrl" alt="" aria-hidden="true" draggable="false"
         @onpointerdown="Segurar" @onpointerup="Soltar" @onpointerleave="Soltar" @onpointercancel="Soltar"
         @oncontextmenu="Ignorar" @oncontextmenu:preventDefault="true" @onclick:stopPropagation="@suprimirClique" />
}
else
{
    <span class="foto-redonda foto-redonda-sil" style="--d:@(Diametro)px" aria-hidden="true">
        <svg viewBox="0 0 100 100" focusable="false">
            <path fill-rule="evenodd" d="@SilhuetasAtleta.Caminho(Sigla, Atleta.Nome)" />
        </svg>
    </span>
}
@if (ampliada)
{
    <span class="foto-zoom" aria-hidden="true">
        <img src="@Atleta.FotoUrl" alt="" />
        <span class="foto-zoom-nome">@Atleta.Nome</span>
    </span>
}

@code {
    [Parameter, EditorRequired] public AtletaEscalavel Atleta { get; set; } = default!;
    /// <summary>Tamanho de referência em px (antes era a largura do cartão); o círculo sai 20% maior para a foto ficar bem visível.</summary>
    [Parameter] public int Tamanho { get; set; } = 46;
    /// <summary>Posição da vaga onde o atleta aparece. Sem ela, vale a primeira posição dele.</summary>
    [Parameter] public PosicaoCampo? Posicao { get; set; }

    private const int TempoSegurarMs = 350;
    private bool ampliada;
    private bool suprimirClique;   // o clique logo após soltar a foto não deve acionar a linha onde ela está
    private CancellationTokenSource? segurando;

    private int Diametro => (int)Math.Round(Tamanho * 1.2);
    private string? Sigla => Posicao?.Sigla() ?? (Atleta.Posicoes.Count > 0 ? Atleta.Posicoes[0].Sigla() : null);

    private async Task Segurar(PointerEventArgs e)
    {
        if (e.Button != 0) return;
        CancelarSegurar();
        suprimirClique = false;
        var cts = segurando = new CancellationTokenSource();
        try { await Task.Delay(TempoSegurarMs, cts.Token); }
        catch (TaskCanceledException) { return; }
        ampliada = true;
        suprimirClique = true;
    }

    private void Soltar()
    {
        CancelarSegurar();
        if (!ampliada) return;
        ampliada = false;
        _ = LiberarCliqueDepois();
    }

    private async Task LiberarCliqueDepois()
    {
        await Task.Delay(350);
        suprimirClique = false;
        StateHasChanged();
    }

    // o menu de contexto (segurar no celular / botão direito) cancelaria o toque e fecharia a foto; um handler real garante o preventDefault
    private void Ignorar() { }

    private void CancelarSegurar()
    {
        segurando?.Cancel();
        segurando?.Dispose();
        segurando = null;
    }

    public void Dispose() => CancelarSegurar();
}
