@page "/ranking"
@implements IDisposable
@attribute [Authorize]
@inject ServicoTorcida Torcidas
@inject ServicoMercado Mercado
@inject ServicoEscalacao Escalacoes

<PageTitle>Ranking · Cartola dos Amigos</PageTitle>

<div class="pagina ranking">
    <h1>Ranking</h1>

    <div class="rk-topo">
        <div class="rk-abas" role="tablist">
            <button type="button" role="tab" class="@(aba == AbaRanking.PontosTime ? "sel" : "")" @onclick="() => TrocarAba(AbaRanking.PontosTime)">Pontos Time</button>
            <button type="button" role="tab" class="@(aba == AbaRanking.PontosAtletas ? "sel" : "")" @onclick="() => TrocarAba(AbaRanking.PontosAtletas)">Pontos Atletas</button>
            <button type="button" role="tab" class="@(aba == AbaRanking.Torcida ? "sel" : "")" @onclick="() => TrocarAba(AbaRanking.Torcida)">Torcida</button>
        </div>

        @if (rodadas.Count > 0 && aba != AbaRanking.PontosAtletas)
        {
            <select class="rk-filtro" aria-label="Filtrar por rodada" value="@(rodadaSel?.ToString() ?? "")" @onchange="TrocarRodada">
                <option value="">Geral</option>
                @foreach (var r in rodadas)
                {
                    <option value="@r">Rodada @r</option>
                }
            </select>
        }
    </div>

    @if (!string.IsNullOrEmpty(avisoSync))
    {
        <p class="erro" role="status">@avisoSync</p>
    }

    @if (carregando)
    {
        <p class="suave centro">Carregando…</p>
    }
    else if (erro is not null)
    {
        <div class="erro" role="alert">@erro <button type="button" class="botao-sec" @onclick="Carregar">Tentar de novo</button></div>
    }
    else if (aba == AbaRanking.PontosAtletas)
    {
        if (carregandoAtletas)
        {
            <p class="suave centro">Carregando pontuação dos atletas…</p>
        }
        else if (erroAtletas is not null)
        {
            <div class="erro" role="alert">@erroAtletas <button type="button" class="botao-sec" @onclick="CarregarAtletas">Tentar de novo</button></div>
        }
        else if (atletasRodada is null || atletasRodada.Atletas.Count == 0)
        {
            <div class="cartao"><p class="suave">Nenhuma partida finalizada ainda.</p></div>
        }
        else
        {
            <div class="rk-rolagem">
                <p class="suave rk-at-resumo">
                    Última partida@(atletasRodada.Data is { } d ? " · " + d.ToString("dd/MM") : "") · @atletasRodada.Atletas.Count atletas
                </p>
                <ol class="rk-at-lista">
                    @foreach (var a in atletasRodada.Atletas.OrderByDescending(x => x.Pontos))
                    {
                        var aberto = extratoAbertoId == a.Id;
                        <li class="rk-at-item">
                            <div class="rk-at-linha @(aberto ? "aberto" : "")" role="button" tabindex="0" aria-expanded="@(aberto ? "true" : "false")"
                                 @onclick="() => AlternarExtrato(a)" @onkeydown="e => AoTeclarAtleta(e, a)">
                                <div class="rk-at-esq">
                                    @if (fotos.TryGetValue(a.Id, out var foto))
                                    {
                                        <img class="foto-redonda" style="--d:2.2rem" src="@foto" alt="@a.Nome" loading="lazy" draggable="false"
                                             @onpointerdown="() => IniciarSegurar(a)" @onpointerup="PararSegurar" @onpointerleave="PararSegurar" @onpointercancel="PararSegurar"
                                             @oncontextmenu="PararSegurar" @oncontextmenu:preventDefault="true" />
                                    }
                                    else
                                    {
                                        <span class="foto-redonda foto-redonda-sil" style="--d:2.2rem" aria-hidden="true">
                                            <SilhuetaAtleta Sigla="@PrimeiraSigla(a.Posicao)" Nome="@a.Nome" />
                                        </span>
                                    }
                                    <span class="rk-at-nome">@a.Nome</span>
                                </div>
                                <span class="rk-at-time">
                                    @if (!string.IsNullOrWhiteSpace(a.TimeNome))
                                    {
                                        <img class="rk-at-escudo" src="img/time-@(SlugTime(a.TimeNome)).png" alt="" onerror="this.style.display='none'" />
                                        <span class="rk-at-time-nome">@a.TimeNome</span>
                                    }
                                </span>
                                <div class="rk-at-dir">
                                    <span class="rk-at-pos">@a.Posicao</span>
                                    <span class="rk-at-pts @(a.Pontos < 0 ? "neg" : "")">@Fmt2(a.Pontos)</span>
                                </div>
                            </div>
                            @if (aberto)
                            {
                                <div class="rk-at-extrato">
                                    @if (carregandoExtratoId == a.Id)
                                    {
                                        <p class="suave centro">Carregando extrato…</p>
                                    }
                                    else if (errosExtrato.TryGetValue(a.Id, out var msgExtrato))
                                    {
                                        <div class="erro" role="alert">@msgExtrato</div>
                                    }
                                    else if (extratos.TryGetValue(a.Id, out var extrato) && extrato is not null)
                                    {
                                        <p class="suave rk-ext-titulo">Última partida@(extrato.Data is { } dtExtrato ? " · " + dtExtrato.ToString("dd/MM") : "")</p>
                                        @foreach (var linhaExtrato in extrato.Linhas)
                                        {
                                            <div class="rk-ext-linha">
                                                <span>@linhaExtrato.Texto</span>
                                                @if (linhaExtrato.Pontua)
                                                {
                                                    <strong class="@(linhaExtrato.Pontos < 0 ? "neg" : "")">@Fmt2(linhaExtrato.Pontos)</strong>
                                                }
                                            </div>
                                        }
                                        <div class="rk-ext-linha total">
                                            <span>Total</span>
                                            <strong class="@(extrato.Total < 0 ? "neg" : "")">@Fmt2(extrato.Total)</strong>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="suave centro">Sem extrato para esse atleta.</p>
                                    }
                                </div>
                            }
                        </li>
                    }
                </ol>
            </div>
        }
    }
    else if (linhas.Count == 0)
    {
        <div class="cartao"><p class="suave">Nenhum time no ranking ainda.</p></div>
    }
    else
    {
        <div class="rk-rolagem">
            <ol class="rk-lista">
                @{
                    var pos = 0;
                }
                @foreach (var l in Ordenadas())
                {
                    pos++;
                    var ouro = l.Torcida >= Torcida.MinDourado;
                    var aberto = abertoId == l.Id;
                    <li class="rk-item">
                        <div class="rk-linha @(ouro ? "ouro" : "") @(l.EhVoce ? "voce" : "") @(aberto ? "aberto" : "")"
                             role="button" tabindex="0" aria-expanded="@(aberto ? "true" : "false")"
                             @onclick="() => Alternar(l)" @onkeydown="e => AoTeclar(e, l)">
                            <span class="rk-pos">@pos</span>
                            <Escudo Config="l.Escudo" Tamanho="46" Coroa="@(l.Coroa && l.Torcida >= Torcida.MinCoroa)"
                                    Estrelas="@(l.Torcida >= Torcida.MinCoroa ? l.Estrelas : 0)" Dourado="@ouro" />
                            <div class="rk-info">
                                <strong>@l.NomeTime @if (l.EhVoce) {
                                    <small>(você)</small>
                                }
                            </strong>
                            <small class="suave">@@@l.NomeUsuario@(string.IsNullOrWhiteSpace(l.Apelido) ? "" : " · Torcida " + l.Apelido)</small>
                        </div>
                        <div class="rk-num @(porTorcida ? "" : "principal")">
                            <strong>@Formato.Pontos(l.Pontos)</strong><small>pts · @(rodadaSel is null ? l.Rodadas + " rod." : "rodada " + rodadaSel)</small>
                        </div>
                        <div class="rk-num @(porTorcida ? "principal" : "")">
                            <strong>@Torcida.Fmt(l.Torcida)</strong><small>torcida · nv @Torcida.Numero(l.Torcida)</small>
                        </div>
                    </div>
                    @if (aberto)
                    {
                        <div class="rk-escalacao">
                            @if (carregandoId == l.Id)
                            {
                                <p class="suave centro">Carregando escalação…</p>
                            }
                            else if (erros.TryGetValue(l.Id, out var msg))
                            {
                                <div class="erro" role="alert">@msg</div>
                            }
                            else if (cache.TryGetValue(l.Id, out var m) && m is not null)
                            {
                                <p class="rk-esc-titulo">Escalação de <strong>@l.NomeTime</strong> · @m.Tatica.Nome</p>
                                var pz = personalizacoes.TryGetValue(l.Id, out var x) ? x : new PersonalizacaoClube(new ClubeConfig(), new CardsConfig());
                                var cl = pz.Clube;
                                var faixa = cl.TemFaixa() && l.Torcida >= Torcida.MinTextos;
                                var temEstadio = !string.IsNullOrWhiteSpace(cl.Estadio) && l.Torcida >= Torcida.MinDourado;   // nome do estádio é recompensa da "Lenda da pelada"
                                if (temEstadio)
                                {
                                    <div class="rk-personalizacao">
                                        <p class="home-estadio">Estádio <strong>@cl.Estadio</strong></p>
                                    </div>
                                }
                                <div class="rk-campo-faixas">
                                    @if (faixa)
                                    {
                                        <FaixaLateral Modelo="@cl.Esquerda()" Cor1="@cl.FaixaCor1" Cor2="@cl.FaixaCor2" Escudo="l.Escudo" />
                                    }
                                    <div class="rk-campo">
                                        <CampoTatico Escalacao="m" Cards="pz.Cards" Estilo="@cl.Campo" Moldura="@cl.Moldura" LinhasCor="@cl.CampoLinhas" Estadio="@cl.EstadioModelo"
                                                     CorGrama1="@cl.CampoCor1" CorGrama2="@cl.CampoCor2" CorMoldura="@cl.MolduraCor"
                                                     CorEstadio1="@cl.EstadioCor1" CorEstadio2="@cl.EstadioCor2" EscudoCard="l.Escudo" />
                                    </div>
                                    @if (faixa)
                                    {
                                        <FaixaLateral Modelo="@cl.Direita()" Cor1="@cl.FaixaCor1" Cor2="@cl.FaixaCor2" Escudo="l.Escudo" />
                                    }
                                </div>
                                @if ((cl.Camisa is not null && l.Torcida >= Torcida.MinCamisa) || (!string.IsNullOrEmpty(cl.Mascote) && l.Torcida >= Torcida.MinMascote))
                                {
                                    <div class="rk-extras">
                                        @if (cl.Camisa is { } c1 && l.Torcida >= Torcida.MinCamisa)
                                        {
                                            <Camisa Padrao="@c1.Padrao" Cor1="@c1.Cor1" Cor2="@c1.Cor2" Cor3="@c1.Cor3" Tamanho="70" />
                                        }
                                        @if (!string.IsNullOrEmpty(cl.Mascote) && l.Torcida >= Torcida.MinMascote)
                                        {
                                            <Mascote Chave="@cl.Mascote" Cor="@cl.MascoteCor" Tamanho="70" />
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="suave centro">Esse time ainda não salvou uma escalação.</p>
                            }
                        </div>
                    }
                </li>
            }
        </ol>
        <p class="suave centro rk-nota">Toque num time para ver a escalação dele. Pontos e torcida de todos os times são atualizados ao abrir o ranking. Só conta a rodada de quem salvou a escalação antes da partida.</p>
    </div>
}
</div>

@* Foto ampliada enquanto o dedo/mouse está segurando a foto do atleta (classe .foto-zoom já existe no CSS) *@
@if (zoomAtleta is not null && fotos.TryGetValue(zoomAtleta.Id, out var fotoZoom))
{
    <div class="foto-zoom" style="z-index:11000" aria-hidden="true">
        <img src="@fotoZoom" alt="" />
        <span class="foto-zoom-nome">@zoomAtleta.Nome</span>
    </div>
}

@code {
    private List<LinhaRankingClube> linhas = new();
    private List<int> rodadas = new();
    private int? rodadaSel;   // null = geral; ao abrir a tela começa na última rodada
    private bool carregando = true, filtroInicial;
    private enum AbaRanking { PontosTime, PontosAtletas, Torcida }
    private AbaRanking aba = AbaRanking.PontosTime;
    private bool porTorcida => aba == AbaRanking.Torcida;

    // aba "Pontos Atletas": última partida finalizada (ObterRodadaAsync)
    private PontuacaoDaRodada? atletasRodada;
    private bool carregandoAtletas, atletasCarregados;
    private string? erroAtletas;
    private string? erro, avisoSync;

    // aba "Pontos Atletas": fotos por id do atleta
    private Dictionary<string, string> fotos = new();

    // segurar a foto para ampliar
    private AtletaRodada? zoomAtleta;
    private CancellationTokenSource? segurarCts;
    private DateTime zoomFimEm = DateTime.MinValue;

    // extrato (descrição dos pontos) do atleta aberto
    private string? extratoAbertoId, carregandoExtratoId;
    private readonly Dictionary<string, ExtratoJogo?> extratos = new();
    private readonly Dictionary<string, string> errosExtrato = new();

    // escalação aberta embaixo de um time
    private string? abertoId, carregandoId;
    private List<AtletaEscalavel>? elenco;
    private readonly Dictionary<string, EscalacaoMontada?> cache = new();
    private readonly Dictionary<string, string> erros = new();
    private readonly Dictionary<string, PersonalizacaoClube> personalizacoes = new();

    private async Task AoTeclar(KeyboardEventArgs e, LinhaRankingClube l)
    {
        if (e.Key is "Enter" or " ") await Alternar(l);
    }

    private async Task Alternar(LinhaRankingClube l)
    {
        if (abertoId == l.Id) { abertoId = null; return; }
        abertoId = l.Id;
        if (cache.ContainsKey(l.Id)) return;

        carregandoId = l.Id;
        erros.Remove(l.Id);
        try
        {
            var tarefaPz = CarregarPersonalizacao(l.Id);
            elenco ??= await Mercado.ObterElencoAsync();
            var salva = await Escalacoes.UltimaDeAsync(l.Id);
            await tarefaPz;
            cache[l.Id] = Montar(salva, elenco);
        }
        catch (ErroMercadoException ex) { erros[l.Id] = ex.Message; }
        catch (ErroEscalacaoException ex) { erros[l.Id] = ex.Message; }
        finally { if (carregandoId == l.Id) carregandoId = null; }
    }

    // Falha aqui não impede de ver a escalação: o campo aparece com o visual padrão
    private async Task CarregarPersonalizacao(string id)
    {
        try { personalizacoes[id] = await Torcidas.PersonalizacaoDeAsync(id); }
        catch (ErroTorcidaException) { }
    }

    private static EscalacaoMontada? Montar(EscalacaoSalva? salva, List<AtletaEscalavel> elenco)
    {
        if (salva is null || salva.Slots.Count == 0) return null;

        var porId = elenco.ToDictionary(a => a.Id);
        var m = new EscalacaoMontada();
        m.AplicarTatica(Tatica.Todas.FirstOrDefault(t => t.Nome == salva.Tatica) ?? Tatica.Padrao);
        foreach (var s in salva.Slots)
        {
            // atleta que saiu do mercado fica de fora do desenho
            if (!porId.TryGetValue(s.AtletaId, out var a) || s.Indice is < 0 or > 5) continue;
            m.Definir(s.Pos, s.Indice, a);
        }
        if (salva.CapitaoId is not null && m.EstaNoCampo(salva.CapitaoId)) m.AlternarCapitao(salva.CapitaoId);
        return m;
    }

    protected override Task OnInitializedAsync() => Carregar();

    private async Task Carregar()
    {
        carregando = true;
        erro = avisoSync = null;
        atletasCarregados = false;
        try
        {
            // atualiza todos os times antes de listar; se falhar, atualiza só o seu e avisa
            try
            {
                await Torcidas.SincronizarTodosAsync();
                await Torcidas.CarregarAsync(false);   // só lê o resumo do seu time (menu lateral)
            }
            catch (ErroTorcidaException ex)
            {
                avisoSync = "Não consegui atualizar os pontos de todos os times: " + ex.Message;
                try { await Torcidas.CarregarAsync(); } catch (ErroTorcidaException) { }
            }
            rodadas = await Torcidas.RodadasDoRankingAsync();
            if (!filtroInicial)
            {
                rodadaSel = rodadas.Count > 0 ? rodadas[0] : null;
                filtroInicial = true;
            }
            linhas = await Torcidas.RankingAsync(rodadaSel);
        }
        catch (ErroTorcidaException ex) { erro = ex.Message; }
        finally { carregando = false; }

        if (aba == AbaRanking.PontosAtletas) await CarregarAtletas();
    }

    private async Task TrocarAba(AbaRanking nova)
    {
        aba = nova;
        if (nova == AbaRanking.PontosAtletas && !atletasCarregados) await CarregarAtletas();
    }

    // Trocar a rodada só relê o ranking; a sincronização já foi feita ao abrir a tela
    private async Task TrocarRodada(ChangeEventArgs e)
    {
        rodadaSel = int.TryParse(e.Value?.ToString(), out var r) ? r : null;
        carregando = true;
        erro = null;
        try { linhas = await Torcidas.RankingAsync(rodadaSel); }
        catch (ErroTorcidaException ex) { erro = ex.Message; }
        finally { carregando = false; }
    }

    private async Task AoTeclarAtleta(KeyboardEventArgs e, AtletaRodada a)
    {
        if (e.Key is "Enter" or " ") await AlternarExtrato(a);
    }

    private async Task IniciarSegurar(AtletaRodada a)
    {
        PararSegurar();
        var cts = segurarCts = new CancellationTokenSource();
        try { await Task.Delay(350, cts.Token); }
        catch (TaskCanceledException) { return; }
        zoomAtleta = a;   // o Blazor redesenha quando o método termina
    }

    private void PararSegurar()
    {
        segurarCts?.Cancel();
        segurarCts = null;
        if (zoomAtleta is null) return;
        zoomAtleta = null;
        zoomFimEm = DateTime.UtcNow;   // o "click" que vem logo depois de soltar não deve abrir o extrato
    }

    public void Dispose() => segurarCts?.Cancel();

    private async Task AlternarExtrato(AtletaRodada a)
    {
        if ((DateTime.UtcNow - zoomFimEm).TotalMilliseconds < 400) return;
        if (extratoAbertoId == a.Id) { extratoAbertoId = null; return; }
        extratoAbertoId = a.Id;
        if (extratos.ContainsKey(a.Id)) return;

        carregandoExtratoId = a.Id;
        errosExtrato.Remove(a.Id);
        try { extratos[a.Id] = await Mercado.ObterExtratoAsync(a.Id); }
        catch (ErroMercadoException ex) { errosExtrato[a.Id] = ex.Message; }
        finally { if (carregandoExtratoId == a.Id) carregandoExtratoId = null; }
    }

    private static string Fmt2(decimal v) => v.ToString("0.00", System.Globalization.CultureInfo.GetCultureInfo("pt-BR"));

    // "MEI/ZAG" -> "MEI": a silhueta usa a primeira posição do atleta
    private static string PrimeiraSigla(string? posicao) => (posicao ?? "").Split('/')[0].Trim();

    // "Vermelho" -> "vermelho": usado no nome do arquivo wwwroot/img/time-vermelho.png
    private static string SlugTime(string? nome)
    {
        var d = (nome ?? "").Trim().ToLowerInvariant().Normalize(System.Text.NormalizationForm.FormD);
        var sb = new System.Text.StringBuilder();
        foreach (var c in d)
        {
            if (System.Globalization.CharUnicodeInfo.GetUnicodeCategory(c) == System.Globalization.UnicodeCategory.NonSpacingMark) continue;
            sb.Append(char.IsLetterOrDigit(c) ? c : '-');
        }
        return sb.ToString().Trim('-');
    }

    private async Task CarregarAtletas()
    {
        extratoAbertoId = null;
        extratos.Clear();
        errosExtrato.Clear();
        carregandoAtletas = true;
        erroAtletas = null;
        try
        {
            atletasRodada = await Mercado.ObterRodadaAsync();
            atletasCarregados = true;

            // fotos vêm do elenco; se falhar, a lista aparece sem foto
            try
            {
                elenco ??= await Mercado.ObterElencoAsync();
                fotos = elenco.Where(x => !string.IsNullOrWhiteSpace(x.FotoUrl)).ToDictionary(x => x.Id, x => x.FotoUrl!);
            }
            catch (ErroMercadoException) { }
        }
        catch (ErroMercadoException ex) { erroAtletas = ex.Message; }
        finally { carregandoAtletas = false; }
    }

    private IEnumerable<LinhaRankingClube> Ordenadas() => porTorcida
        ? linhas.OrderByDescending(l => l.Torcida).ThenByDescending(l => l.Pontos)
        : linhas.OrderByDescending(l => l.Pontos).ThenByDescending(l => l.Torcida);
}
