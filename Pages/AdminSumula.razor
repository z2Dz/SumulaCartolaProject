    private void AbrirTrocas()
    {
        if (sujo) { erro = "Salve ou descarte as alterações da súmula antes de mexer nas substituições."; return; }
        erro = erroTrocas = null;
        arrastandoTroca = selecionadoTroca = null;
        popupTrocas = true;
    }

    private void FecharTrocas() { popupTrocas = false; arrastandoTroca = selecionadoTroca = null; }
    private void TrocarAbaTrocas(string ld) { abaTrocas = ld; selecionadoTroca = null; arrastandoTroca = null; erroTrocas = null; }
    private void IniciarArrasto(Guid id) => arrastandoTroca = id;
    private void FimArrasto() => arrastandoTroca = null;

    // O 2º tempo sai da ordem de chegada (PlanoTempos): trocar dois atletas de lugar nela troca quem ocupa cada vaga.
    // A chegada é salva na hora e a súmula recarregada, então a troca já vale nos "sai no 2º / entra no 2º" da lista.
    private async Task TrocarPosicoes(Guid a, Guid b)
    {
        if (a == b || partida is null || partida.Finalizada || salvandoTrocas) return;
        erroTrocas = null;

        var ia = chegada.FindIndex(c => c.Id == a);
        var ib = chegada.FindIndex(c => c.Id == b);
        if (ia < 0 || ib < 0)
        {
            erroTrocas = "Esse atleta entrou só na súmula e não está na ordem de chegada. Adicione-o na ordem de chegada para trocá-lo.";
            return;
        }
        if (chegada[ia].Lado != chegada[ib].Lado) return;   // só dentro do mesmo time

        (chegada[ia], chegada[ib]) = (chegada[ib], chegada[ia]);
        salvandoTrocas = true;
        try
        {
            await Servico.SalvarChegadaAsync(partida.Id, chegada);
            await Carregar();
        }
        catch (ErroAdminException ex)
        {
            (chegada[ia], chegada[ib]) = (chegada[ib], chegada[ia]);   // não salvou: volta como estava
            erroTrocas = ex.Message;
        }
        finally { salvandoTrocas = false; }
    }

    private async Task SoltarTroca(Guid destino)
    {
        var origem = arrastandoTroca;
        arrastandoTroca = null;
        if (origem is { } o) await TrocarPosicoes(o, destino);
    }

    // Toque (celular): o primeiro toque seleciona, o segundo troca com o card tocado
    private async Task TocarTroca(Guid id)
    {
        if (selecionadoTroca is not { } sel) { selecionadoTroca = id; return; }
        selecionadoTroca = null;
        if (sel != id) await TrocarPosicoes(sel, id);
    }

    private int ProximoNumero(string ld)
    {
        var usados = linhas.Where(l => l.Lado == ld).Select(l => l.Numero).ToHashSet();
        for (var n = 1; n <= LinhaSumula.MaxNumero; n++)
            if (!usados.Contains(n)) return n;
        return 0;   // lado cheio
    }

    private bool AdicionarLinha(AtletaResumo a, string ld)
    {
        var n = ProximoNumero(ld);
        if (n == 0) { erro = $"O time {TimePelada.Rotulo(ld)} já tem {LinhaSumula.MaxNumero} atletas."; return false; }
        linhas.Add(new LinhaSumula { AtletaId = a.Id, Nome = a.Nome, Lado = ld, Numero = n });
        novos.Add(a.Id);
        return true;
    }

