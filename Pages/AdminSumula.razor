@code {
    [SupplyParameterFromQuery(Name = "partida")] public Guid? PartidaInicial { get; set; }

    private List<PartidaResumo> partidas = new();
    private List<AtletaResumo> atletas = new();
    private List<LinhaSumula> linhas = new();
    private List<ChegadaItem> chegada = new();   // ordem de chegada da partida, base dos titulares e substitutos
    private PartidaResumo? partida;
    private string status = "agendada", lado = LinhaSumula.Casa;
    private string? erro, aviso;
    private bool carregando = true, sujo, salvando, statusMudou;

    // Modal "Adicionar atleta"
    private AtletaResumo? editando;

    // ----- Linha do tempo / popup de lance -----
    private enum TipoLance { Gol, GolContra, Assistencia, ChuteGol, Defesa, PenaltiCometido, PenaltiPerdido, Amarelo, Azul, Vermelho }

    /// <summary>Um lance da linha do tempo. Tempo 0 = sem tempo gravado (o banco só guarda por tempo gols, gols contra e cartões).</summary>
    private class Lance
    {
        public Guid Id { get; } = Guid.NewGuid();
        public Guid AtletaId { get; set; }
        public string Lado { get; set; } = LinhaSumula.Casa;
        public TipoLance Tipo { get; set; }
        public int Tempo { get; set; } = 1;
        public bool Reconstruido { get; set; }
        /// <summary>Só para gol: quem deu a assistência (mostrada junto do gol na linha do tempo).</summary>
        public Guid? AssistenteId { get; set; }
    }

    private record ItemLinha(Lance Ev, int Casa, int Visitante);

    private static readonly TipoLance[] ComTempo = { TipoLance.Gol, TipoLance.GolContra, TipoLance.Amarelo, TipoLance.Azul, TipoLance.Vermelho };
    /// <summary>Botões de "Outras ações" no popup. A assistência não tem botão: vai junto do gol (ou pelo ✎ do gol).</summary>
    private static readonly TipoLance[] AcoesRapidas = { TipoLance.ChuteGol, TipoLance.Defesa, TipoLance.PenaltiCometido, TipoLance.PenaltiPerdido };

    private static string ClasseAcao(TipoLance t) => t switch
    {
        TipoLance.ChuteGol => "chute",
        TipoLance.Defesa => "defesa",
        TipoLance.PenaltiCometido => "pen-com",
        TipoLance.PenaltiPerdido => "pen-perd",
        TipoLance.Gol => "gol",
        TipoLance.GolContra => "gol-contra",
        TipoLance.Amarelo => "cartao-am",
        TipoLance.Azul => "cartao-az",
        TipoLance.Vermelho => "cartao-ver",
        _ => ""
    };

    private static MarkupString IconeAcao(TipoLance t) => new(t switch
    {
        TipoLance.ChuteGol => "<circle cx=\"12\" cy=\"12\" r=\"9\"/><circle cx=\"12\" cy=\"12\" r=\"4\"/><circle cx=\"12\" cy=\"12\" r=\"0.8\" fill=\"currentColor\"/>",
        TipoLance.Defesa => "<path d=\"M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z\"/>",
        TipoLance.PenaltiCometido => "<path d=\"M12 3l10 18H2z\"/><path d=\"M12 10v5\"/><circle cx=\"12\" cy=\"18\" r=\"0.8\" fill=\"currentColor\"/>",
        TipoLance.PenaltiPerdido => "<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M8.5 8.5l7 7M15.5 8.5l-7 7\"/>",
        TipoLance.Gol => "<circle cx=\"12\" cy=\"12\" r=\"9\"/><path d=\"M12 8l3.5 2.5-1.3 4h-4.4l-1.3-4z\"/><path d=\"M12 8V3.5M15.5 10.5l4-1.3M14.2 14.5l2.4 3.3M9.8 14.5l-2.4 3.3M8.5 10.5l-4-1.3\"/>",
        TipoLance.GolContra => "<path d=\"M9 14l-4-4 4-4\"/><path d=\"M5 10h9a5 5 0 010 10h-3\"/>",
        TipoLance.Amarelo or TipoLance.Azul or TipoLance.Vermelho => "<rect x=\"7\" y=\"3\" width=\"10\" height=\"18\" rx=\"2\" fill=\"currentColor\" fill-opacity=\".9\"/>",
        _ => ""
    });

    private static readonly TipoLance[] OutrasAcoes = { TipoLance.Assistencia, TipoLance.ChuteGol, TipoLance.Defesa, TipoLance.PenaltiCometido, TipoLance.PenaltiPerdido };

    private readonly List<Lance> lances = new();
    private bool modalLance, escolhendoAssist, abaLista;
    private Guid? jogadorLance, assistLance;
    private int tempoLance = 1;

    private static bool EhGol(TipoLance t) => t is TipoLance.Gol or TipoLance.GolContra;
    private static bool EhCartao(TipoLance t) => t is TipoLance.Amarelo or TipoLance.Azul or TipoLance.Vermelho;

    private static string ClasseTipo(TipoLance t) => t switch
    {
        TipoLance.Amarelo => "sm2-tl-am",
        TipoLance.Azul => "sm2-tl-az",
        TipoLance.Vermelho => "sm2-tl-ver",
        TipoLance.Gol => "sm2-tl-gol",
        TipoLance.GolContra => "sm2-tl-gc",
        _ => "sm2-tl-out"
    };

    private static string TempoTxt(Lance lc) => lc.Tempo == 0 ? "—" : $"{lc.Tempo}T";

    /// <summary>Camisa do atleta neste jogo; nulo enquanto o número ainda não foi definido.</summary>
    private int? NumeroDe(Guid id)
    {
        var l = linhas.FirstOrDefault(x => x.AtletaId == id);
        if (l is null || !confirmados.Contains(id)) return null;
        return l.Numero;
    }

    private static string RotuloDe(TipoLance t) => t switch
    {
        TipoLance.Gol => "Gol",
        TipoLance.GolContra => "Gol contra",
        TipoLance.Assistencia => "Assistência",
        TipoLance.ChuteGol => "Chute ao gol",
        TipoLance.Defesa => "Defesa",
        TipoLance.PenaltiCometido => "Pênalti cometido",
        TipoLance.PenaltiPerdido => "Pênalti perdido",
        TipoLance.Amarelo => "Cartão amarelo",
        TipoLance.Azul => "Cartão azul",
        _ => "Cartão vermelho"
    };

    private static string SiglaDe(TipoLance t) => t switch
    {
        TipoLance.Assistencia => "ASS",
        TipoLance.ChuteGol => "CHUT",
        TipoLance.Defesa => "DEF",
        TipoLance.PenaltiCometido => "P.C.",
        TipoLance.PenaltiPerdido => "P.P.",
        _ => ""
    };

    private static int Maximo(TipoLance t) => t switch
    {
        TipoLance.Assistencia => 30,
        TipoLance.PenaltiCometido or TipoLance.PenaltiPerdido => 20,
        _ => 99
    };

    private int SemCamisa(string ld) => linhas.Count(l => l.Lado == ld && !confirmados.Contains(l.AtletaId));

    private string Camisa(LinhaSumula l) => confirmados.Contains(l.AtletaId) ? $"Camisa {l.Numero}" : "Sem número definido";

    private string NomeDe(Guid id) => linhas.FirstOrDefault(l => l.AtletaId == id)?.Nome ?? "?";

    /// <summary>Contador do atleta para o tipo. Só gol, gol contra e cartão separam por tempo.</summary>
    private static int Qtd(LinhaSumula l, TipoLance tipo, int tempo) => tipo switch
    {
        TipoLance.Gol => tempo == 1 ? l.Gols1T : l.Gols2T,
        TipoLance.GolContra => tempo == 1 ? l.GolsContra1T : l.GolsContra2T,
        TipoLance.Amarelo => tempo == 1 ? l.Amarelo1T : l.Amarelo2T,
        TipoLance.Azul => tempo == 1 ? l.Azul1T : l.Azul2T,
        TipoLance.Vermelho => tempo == 1 ? l.Vermelho1T : l.Vermelho2T,
        TipoLance.Assistencia => l.Assistencias,
        TipoLance.ChuteGol => l.ChutesGol,
        TipoLance.Defesa => l.Defesas,
        TipoLance.PenaltiCometido => l.PenaltisCometidos,
        _ => l.PenaltisPerdidos
    };

    /// <summary>Soma ou tira do contador. Devolve false quando não mudou (limite ou já zerado).</summary>
    private static bool Ajustar(LinhaSumula l, TipoLance tipo, int tempo, int delta)
    {
        var atual = Qtd(l, tipo, tempo);
        var v = Math.Clamp(atual + delta, 0, Maximo(tipo));
        if (v == atual) return false;

        switch (tipo)
        {
            case TipoLance.Gol: if (tempo == 1) l.Gols1T = v; else l.Gols2T = v; break;
            case TipoLance.GolContra: if (tempo == 1) l.GolsContra1T = v; else l.GolsContra2T = v; break;
            case TipoLance.Amarelo: if (tempo == 1) l.Amarelo1T = v; else l.Amarelo2T = v; break;
            case TipoLance.Azul: if (tempo == 1) l.Azul1T = v; else l.Azul2T = v; break;
            case TipoLance.Vermelho: if (tempo == 1) l.Vermelho1T = v; else l.Vermelho2T = v; break;
            case TipoLance.Assistencia: l.Assistencias = v; break;
            case TipoLance.ChuteGol: l.ChutesGol = v; break;
            case TipoLance.Defesa: l.Defesas = v; break;
            case TipoLance.PenaltiCometido: l.PenaltisCometidos = v; break;
            default: l.PenaltisPerdidos = v; break;
        }

        // Assistência, chute, defesa e pênalti também guardam quantos foram no 1T e no 2T
        if (!ComTempo.Contains(tipo) && tempo is 1 or 2)
            AjustarPorTempo(l, tipo, tempo, v - atual);
        return true;
    }

    private static int PorTempo(LinhaSumula l, TipoLance tipo, int tempo) => (tipo, tempo) switch
    {
        (TipoLance.Assistencia, 1) => l.Assistencias1T,
        (TipoLance.Assistencia, 2) => l.Assistencias2T,
        (TipoLance.ChuteGol, 1) => l.ChutesGol1T,
        (TipoLance.ChuteGol, 2) => l.ChutesGol2T,
        (TipoLance.Defesa, 1) => l.Defesas1T,
        (TipoLance.Defesa, 2) => l.Defesas2T,
        (TipoLance.PenaltiCometido, 1) => l.PenaltisCometidos1T,
        (TipoLance.PenaltiCometido, 2) => l.PenaltisCometidos2T,
        (TipoLance.PenaltiPerdido, 1) => l.PenaltisPerdidos1T,
        (TipoLance.PenaltiPerdido, 2) => l.PenaltisPerdidos2T,
        _ => 0
    };

    private static void AjustarPorTempo(LinhaSumula l, TipoLance tipo, int tempo, int delta)
    {
        var v = Math.Max(0, PorTempo(l, tipo, tempo) + delta);
        switch (tipo, tempo)
        {
            case (TipoLance.Assistencia, 1): l.Assistencias1T = v; break;
            case (TipoLance.Assistencia, 2): l.Assistencias2T = v; break;
            case (TipoLance.ChuteGol, 1): l.ChutesGol1T = v; break;
            case (TipoLance.ChuteGol, 2): l.ChutesGol2T = v; break;
            case (TipoLance.Defesa, 1): l.Defesas1T = v; break;
            case (TipoLance.Defesa, 2): l.Defesas2T = v; break;
            case (TipoLance.PenaltiCometido, 1): l.PenaltisCometidos1T = v; break;
            case (TipoLance.PenaltiCometido, 2): l.PenaltisCometidos2T = v; break;
            case (TipoLance.PenaltiPerdido, 1): l.PenaltisPerdidos1T = v; break;
            case (TipoLance.PenaltiPerdido, 2): l.PenaltisPerdidos2T = v; break;
        }
    }

    /// <summary>Quantos lances do tipo existem naquele tempo (0 = sem tempo gravado: o total menos o que tem 1T/2T).</summary>
    private static int QtdNoTempo(LinhaSumula l, TipoLance tipo, int tempo)
    {
        if (ComTempo.Contains(tipo)) return tempo == 0 ? 0 : Qtd(l, tipo, tempo);
        if (tempo != 0) return PorTempo(l, tipo, tempo);
        return Math.Max(0, Qtd(l, tipo, 0) - PorTempo(l, tipo, 1) - PorTempo(l, tipo, 2));
    }

    /// <summary>Monta os lances a partir dos contadores salvos: sem tempo primeiro, depois 1T e 2T. Dentro do tempo a ordem é aproximada.</summary>
    private void ReconstruirLances()
    {
        lances.Clear();
        var ordenados = linhas.OrderBy(x => x.Lado).ThenBy(x => x.Numero).ToList();

        foreach (var tipo in OutrasAcoes)
            foreach (var l in ordenados)
                for (var i = 0; i < QtdNoTempo(l, tipo, 0); i++)
                    lances.Add(new Lance { AtletaId = l.AtletaId, Lado = l.Lado, Tipo = tipo, Tempo = 0, Reconstruido = true });

        foreach (var tempo in new[] { 1, 2 })
        {
            var ligadas = new Dictionary<Guid, int>();   // assistências deste tempo que já estão coladas a um gol

            foreach (var tipo in ComTempo.Concat(OutrasAcoes))
                foreach (var l in ordenados)
                {
                    var qtd = QtdNoTempo(l, tipo, tempo);
                    if (tipo == TipoLance.Assistencia) qtd = Math.Max(0, qtd - ligadas.GetValueOrDefault(l.AtletaId));
                    var pares = tipo == TipoLance.Gol ? l.GolsAssistidos.Where(g => g.Tempo == tempo).ToList() : new List<GolAssistido>();

                    for (var i = 0; i < qtd; i++)
                    {
                        var lance = new Lance { AtletaId = l.AtletaId, Lado = l.Lado, Tipo = tipo, Tempo = tempo, Reconstruido = true };
                        if (i < pares.Count && linhas.FirstOrDefault(x => x.AtletaId == pares[i].Assistente) is { } ass)
                        {
                            lance.AssistenteId = ass.AtletaId;
                            ligadas[ass.AtletaId] = ligadas.GetValueOrDefault(ass.AtletaId) + 1;
                        }
                        lances.Add(lance);
                    }
                }
        }
    }

    /// <summary>Do lance mais novo para o mais antigo, já com o placar corrido de cada gol.</summary>
    private List<ItemLinha> LinhaDoTempo()
    {
        int c = 0, v = 0;
        var cronologica = new List<ItemLinha>();
        foreach (var lc in lances.OrderBy(x => x.Tempo))   // OrderBy é estável: mantém a ordem de registro dentro do tempo
        {
            if (lc.Tipo == TipoLance.Gol) { if (lc.Lado == LinhaSumula.Casa) c++; else v++; }
            else if (lc.Tipo == TipoLance.GolContra) { if (lc.Lado == LinhaSumula.Casa) v++; else c++; }
            cronologica.Add(new ItemLinha(lc, c, v));
        }
        return Enumerable.Reverse(cronologica).ToList();
    }

    private void AbrirLance(string ld)
    {
        lado = ld;
        modalLance = true;
        abaLista = false;
        jogadorLance = null;
        escolhendoAssist = false;
        assistLance = null;
    }

    private void FecharLance()
    {
        modalLance = false;
        jogadorLance = null;
        escolhendoAssist = false;
        assistLance = null;
    }

    private void TrocarJogador() { jogadorLance = null; escolhendoAssist = false; assistLance = null; }
    private void EscolherGol() { escolhendoAssist = true; assistLance = null; }
    private void AlternarAssist(Guid id) => assistLance = assistLance == id ? null : id;

    private void AbrirAdicionarDoLance() { FecharLance(); AbrirModal(); }

    /// <summary>
    /// Soma (+1) ou desfaz (-1) um lance nos contadores. Gol com assistente mexe também na assistência dele
    /// e no registro de "gol assistido" do autor. Devolve false (sem alterar nada) se algum contador estourar o limite.
    /// </summary>
    private bool AplicarLance(TipoLance tipo, LinhaSumula autor, int tempo, LinhaSumula? assistente, int delta)
    {
        if (!Ajustar(autor, tipo, tempo, delta)) return false;
        if (tipo != TipoLance.Gol || assistente is null) return true;

        if (!Ajustar(assistente, TipoLance.Assistencia, tempo, delta))
        {
            Ajustar(autor, tipo, tempo, -delta);   // volta o gol
            return false;
        }

        if (delta > 0) autor.GolsAssistidos.Add(new GolAssistido(assistente.AtletaId, tempo));
        else
        {
            var k = autor.GolsAssistidos.FindIndex(g => g.Assistente == assistente.AtletaId && g.Tempo == tempo);
            if (k >= 0) autor.GolsAssistidos.RemoveAt(k);
        }
        return true;
    }

    /// <summary>Registra o lance do jogador escolhido. Gol com assistente vira um cartão só (gol + assistência).</summary>
    private void RegistrarLance(TipoLance tipo, Guid? assistenteId = null)
    {
        var l = linhas.FirstOrDefault(x => x.AtletaId == jogadorLance);
        if (l is null) return;

        var ass = tipo == TipoLance.Gol && assistenteId is { } aid ? linhas.FirstOrDefault(x => x.AtletaId == aid) : null;
        if (!AplicarLance(tipo, l, tempoLance, ass, +1))
        {
            if (ass is not null && AplicarLance(tipo, l, tempoLance, null, +1))
            {
                aviso = $"{ass.Nome} já está no limite de assistências: o gol foi registrado sem assistência.";
                ass = null;
            }
            else
            {
                aviso = $"{RotuloDe(tipo)}: {l.Nome} já está no limite.";
                FecharLance();
                return;
            }
        }

        lances.Add(new Lance { AtletaId = l.AtletaId, Lado = l.Lado, Tipo = tipo, Tempo = tempoLance, AssistenteId = ass?.AtletaId });

        // Começou a registrar lance numa partida agendada: sugere "Em andamento" (só vale ao salvar)
        if (status == "agendada") { status = "em_andamento"; statusMudou = true; }

        Marcar();
        FecharLance();
    }

    // ----- Edição de lance -----
    private Lance? lanceEditando;
    private Guid editAtleta;
    private TipoLance editTipo;
    private int editTempo = 1;
    private Guid? editAssist;

    private void AbrirEdicao(Lance lc)
    {
        lanceEditando = lc;
        editAtleta = lc.AtletaId;
        editTipo = lc.Tipo;
        editTempo = lc.Tempo;
        editAssist = lc.AssistenteId;
    }

    private void FecharEdicao() => lanceEditando = null;

    /// <summary>Muda atleta, lance, tempo ou assistente: desfaz o lance antigo e aplica o novo (se o novo estourar o limite, volta tudo).</summary>
    private void SalvarEdicao()
    {
        var lc = lanceEditando;
        if (lc is null) return;

        var antiga = linhas.FirstOrDefault(x => x.AtletaId == lc.AtletaId);
        var nova = linhas.FirstOrDefault(x => x.AtletaId == editAtleta);
        if (antiga is null || nova is null) { lanceEditando = null; return; }

        var assAntiga = lc.AssistenteId is { } a0 ? linhas.FirstOrDefault(x => x.AtletaId == a0) : null;
        var assNova = editTipo == TipoLance.Gol && editAssist is { } a1
            ? linhas.FirstOrDefault(x => x.AtletaId == a1 && x.AtletaId != nova.AtletaId) : null;

        // Gol e cartão sempre têm tempo; os demais lances podem ficar "sem tempo"
        var tempoNovo = ComTempo.Contains(editTipo) && editTempo == 0 ? 1 : editTempo;
        if (antiga == nova && lc.Tipo == editTipo && lc.Tempo == tempoNovo && assAntiga?.AtletaId == assNova?.AtletaId)
        { lanceEditando = null; return; }

        var tirou = AplicarLance(lc.Tipo, antiga, lc.Tempo, assAntiga, -1);
        if (!AplicarLance(editTipo, nova, tempoNovo, assNova, +1))
        {
            if (tirou) AplicarLance(lc.Tipo, antiga, lc.Tempo, assAntiga, +1);
            aviso = $"{RotuloDe(editTipo)}: {nova.Nome} ou o assistente já está no limite.";
            lanceEditando = null;
            return;
        }

        lc.AtletaId = nova.AtletaId;
        lc.Lado = nova.Lado;
        lc.Tipo = editTipo;
        lc.Tempo = tempoNovo;
        lc.AssistenteId = assNova?.AtletaId;
        lc.Reconstruido = false;
        lanceEditando = null;
        Marcar();
    }

    private void DesfazerLance(Lance lc)
    {
        var l = linhas.FirstOrDefault(x => x.AtletaId == lc.AtletaId);
        var ass = lc.AssistenteId is { } aid ? linhas.FirstOrDefault(x => x.AtletaId == aid) : null;
        if (l is not null) AplicarLance(lc.Tipo, l, lc.Tempo, ass, -1);
        lances.Remove(lc);
        Marcar();
    }

    private void AplicarEdicao(AtletaResumo novo)
    {
        foreach (var a in atletas.Where(x => x.Id == novo.Id)) { a.Nome = novo.Nome; a.FotoUrl = novo.FotoUrl; a.Posicoes = novo.Posicoes; }
        foreach (var l in linhas.Where(x => x.AtletaId == novo.Id)) l.Nome = novo.Nome;
        editando = null;
    }

    private bool modal, registrando;
    private string aba = "lista", busca = "", novoNome = "";
    private string? erroModal, fotoPrevia;
    private HashSet<string> novasPosicoes = new();
    private byte[]? fotoBytes;
    private readonly HashSet<Guid> confirmados = new();   // camisa com número definido: salvo no banco (sumula_camisas) ou digitado agora
    private bool camisasPendentes, camisasIndisponivel;   // pendentes = digitou e ainda não salvou; indisponível = SQL das camisas não rodou
    private string? erroCamisas, avisoCamisas;
    private readonly HashSet<Guid> novos = new();   // entraram agora: número ainda é o automático

    // Goleiros primeiro; técnicos nunca aparecem na súmula
    private static bool EhTecnico(AtletaResumo a) =>
        a.Posicoes.Count > 0 && a.Posicoes.All(x => AnaliseTime.Normalizar(x) == "TEC");

    /// <summary>Atletas do time na ordem de chegada (a mesma da tela de chegada); quem entrou só na súmula vem depois.</summary>
    private IEnumerable<LinhaSumula> LinhasDe(string ld)
    {
        var ordem = new Dictionary<Guid, int>();
        for (var k = 0; k < chegada.Count; k++) ordem.TryAdd(chegada[k].Id, k);

        var goleiros = atletas.Where(AnaliseTime.EhSoGoleiro).Select(a => a.Id).ToHashSet();

        return linhas.Where(l => l.Lado == ld)
                     .OrderBy(l => goleiros.Contains(l.AtletaId) ? 0 : 1)   // goleiro no topo
                     .ThenBy(l => ordem.TryGetValue(l.AtletaId, out var pos) ? pos : int.MaxValue)
                     .ThenBy(l => linhas.IndexOf(l));
    }
    private List<AtletaResumo> Disponiveis => atletas
        .Where(a => linhas.All(l => l.AtletaId != a.Id))
        .Where(a => a.Posicoes.Count == 0 || a.Posicoes.Any(p => p != "TEC"))   // técnico não entra na súmula
        .Where(a => string.IsNullOrWhiteSpace(busca) || a.Nome.Contains(busca.Trim(), StringComparison.OrdinalIgnoreCase))
        .OrderBy(a => a.Nome)
        .ToList();
    private record PapelJogo(string Css, string Rotulo);

    /// <summary>Titulares (10 primeiros da chegada, só linha) e quem entra/sai no 2º tempo, para o time informado.</summary>
    private Dictionary<Guid, PapelJogo> PapeisDe(string ld)
    {
        var noLado = linhas.Where(l => l.Lado == ld).ToList();
        var ids = noLado.Select(l => l.AtletaId).ToHashSet();
        var goleiros = atletas.Where(AnaliseTime.EhSoGoleiro).Select(a => a.Id).ToHashSet();

        var ordemChegada = chegada.Where(c => ids.Contains(c.Id) && !goleiros.Contains(c.Id)).Cast<AtletaResumo>().ToList();
        var naChegada = ordemChegada.Select(a => a.Id).ToHashSet();
        var extras = noLado.Where(l => !naChegada.Contains(l.AtletaId) && !goleiros.Contains(l.AtletaId))
                           .OrderBy(l => l.Numero)
                           .Select(l => new AtletaResumo { Id = l.AtletaId, Nome = l.Nome });

        var plano = PlanoTempos.Montar(ordemChegada.Concat(extras));
        var mapa = new Dictionary<Guid, PapelJogo>();
        foreach (var a in plano.Primeiro) mapa[a.Id] = new("titular", "Titular");
        foreach (var t in plano.Trocas)
        {
            mapa[t.Sai.Id] = new("sai", $"Titular · sai no 2º (entra {t.Entra.Nome})");
            mapa[t.Entra.Id] = new("entra", $"Reserva · entra no 2º (lugar de {t.Sai.Nome})");
        }
        foreach (var a in plano.SemVaga) mapa[a.Id] = new("semvaga", "Reserva · sem vaga");
        return mapa;
    }

    private bool EhGoleiro(Guid atletaId) => atletas.Any(a => a.Id == atletaId && AnaliseTime.EhSoGoleiro(a));

    private int Contar(string ld) => linhas.Count(l => l.Lado == ld);
    // Placar: gols do lado + gols contra cometidos pelo adversário.
    private int GolsDoLado(string ld) =>
        linhas.Where(l => l.Lado == ld).Sum(l => l.Gols) +
        linhas.Where(l => l.Lado != ld).Sum(l => l.GolsContra);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            partidas = await Servico.ListarPartidasAsync();
            atletas = await Servico.ListarAtletasAsync();
            if (partidas.Count > 0)
            {
                partida = partidas.FirstOrDefault(p => p.Id == PartidaInicial)
                          ?? partidas.Where(p => p.Status is "agendada" or "em_andamento")
                                     .OrderBy(p => p.DataHora).FirstOrDefault()
                          ?? partidas[0];
                await Carregar();
            }
        }
        catch (ErroAdminException ex) { erro = ex.Message; }
        carregando = false;
    }

    private async Task AoTrocarPartida(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var id)) return;
        partida = partidas.First(p => p.Id == id);
        await Carregar();
    }

    private async Task Carregar()
    {
        erro = aviso = null;
        try
        {
            linhas = await Servico.ObterSumulaAsync(partida!.Id);
            var tecnicos = atletas.Where(EhTecnico).Select(a => a.Id).ToHashSet();
            linhas.RemoveAll(l => tecnicos.Contains(l.AtletaId));   // técnico não entra na súmula
            ReconstruirLances();
            try { chegada = await Servico.ObterChegadaAsync(partida.Id); }
            catch (Exception)
            {
                chegada = new();   // sem a chegada, as listas caem na ordem do banco (por número de camisa)
                aviso = "Não consegui ler a ordem de chegada desta partida: as listas estão fora dessa ordem.";
            }
            novos.Clear();
            confirmados.Clear();
            camisasPendentes = camisasIndisponivel = false;
            erroCamisas = avisoCamisas = null;

            // A camisa só aparece preenchida se o admin já a salvou nesta partida. O "numero" da súmula é provisório.
            try
            {
                var salvas = await Servico.ObterCamisasAsync(partida.Id);
                foreach (var l in linhas)
                    if (salvas.TryGetValue(l.AtletaId, out var c) && c.Lado == l.Lado)
                    {
                        l.Numero = c.Numero;
                        confirmados.Add(l.AtletaId);
                    }
            }
            catch (ErroAdminException) { camisasIndisponivel = true; }   // SQL das camisas ainda não rodou: tudo fica sem camisa
            AjustarProvisorios(LinhaSumula.Casa);
            AjustarProvisorios(LinhaSumula.Visitante);
            status = partida.Status;
            sujo = statusMudou = false;

            // Partida que já tem gente na súmula está acontecendo: sugere "Em andamento".
            // Só vale de fato quando o admin salvar a súmula.
            if (status == "agendada" && linhas.Count > 0)
            {
                status = "em_andamento";
                statusMudou = true;
            }

        }
        catch (ErroAdminException ex) { erro = ex.Message; }
    }

    private Task Descartar() => Carregar();

    private void AoTrocarStatus(ChangeEventArgs e)
    {
        status = e.Value?.ToString() ?? status;
        statusMudou = status != partida!.Status;
        aviso = null;
    }

    private void Marcar() { sujo = true; aviso = null; }

    private int ProximoNumero(string ld)
    {
        var usados = linhas.Where(l => l.Lado == ld).Select(l => l.Numero).ToHashSet();
        for (var n = 1; n <= LinhaSumula.MaxNumero; n++)
            if (!usados.Contains(n)) return n;
        return 0;   // lado cheio
    }

    private bool AdicionarLinha(AtletaResumo a, string ld)
    {
        var n = ProximoNumero(ld);
        if (n == 0) { erro = $"O time {TimePelada.Rotulo(ld)} já tem {LinhaSumula.MaxNumero} atletas."; return false; }
        linhas.Add(new LinhaSumula { AtletaId = a.Id, Nome = a.Nome, Lado = ld, Numero = n });
        novos.Add(a.Id);
        return true;
    }

    private void AbrirModal() { modal = true; aba = "lista"; busca = ""; erroModal = null; }
    private void FecharModal() { modal = false; LimparNovo(); }

    private void LimparNovo() { novoNome = ""; novasPosicoes = new(); fotoBytes = null; fotoPrevia = null; }

    private void AdicionarDaLista(AtletaResumo a)
    {
        erroModal = null;
        if (AdicionarLinha(a, lado)) Marcar();
        else { erroModal = erro; erro = null; }
    }

    private void AlternarPosicao(string sigla)
    {
        if (!novasPosicoes.Remove(sigla)) novasPosicoes.Add(sigla);
    }

    private async Task AoEscolherFoto(InputFileChangeEventArgs e)
    {
        erroModal = null;
        try
        {
            var reduzida = await e.File.RequestImageFileAsync("image/jpeg", 400, 400);
            using var origem = reduzida.OpenReadStream(2 * 1024 * 1024);
            using var ms = new MemoryStream();
            await origem.CopyToAsync(ms);
            fotoBytes = ms.ToArray();
            fotoPrevia = "data:image/jpeg;base64," + Convert.ToBase64String(fotoBytes);
        }
        catch (Exception)
        {
            fotoBytes = null; fotoPrevia = null;
            erroModal = "Não consegui ler essa foto. Tente outra imagem.";
            return;
        }
    }

    private async Task RegistrarEAdicionar()
    {
        erroModal = null;
        if (string.IsNullOrWhiteSpace(novoNome)) { erroModal = "Informe o nome do atleta."; return; }
        if (novasPosicoes.Count == 0) { erroModal = "Escolha ao menos uma posição."; return; }
        if (ProximoNumero(lado) == 0) { erroModal = $"O time {TimePelada.Rotulo(lado)} já tem {LinhaSumula.MaxNumero} atletas."; return; }

        registrando = true;
        try
        {
            string? url = fotoBytes is null ? null : await Servico.EnviarFotoAsync(fotoBytes);
            var posicoes = PosicoesAtleta.Todas.Select(p => p.Sigla).Where(novasPosicoes.Contains);
            var novo = await Servico.RegistrarAtletaAsync(novoNome.Trim(), posicoes, url);
            atletas.Add(novo);
            AdicionarLinha(novo, lado);
            Marcar();
            aviso = $"{novo.Nome} registrado e adicionado ao time {TimePelada.Rotulo(lado)}. Salve a súmula.";
            LimparNovo();
            modal = false;
        }
        catch (ErroAdminException ex) { erroModal = ex.Message; }
        registrando = false;
    }

    private void Remover(LinhaSumula l)
    {
        // gols dele que tinham assistência: a assistência do colega sai junto
        foreach (var gol in lances.Where(x => x.AtletaId == l.AtletaId && x.AssistenteId is not null).ToList())
            if (linhas.FirstOrDefault(x => x.AtletaId == gol.AssistenteId) is { } colega)
                Ajustar(colega, TipoLance.Assistencia, gol.Tempo, -1);
        // gols de outros que ele assistiu: ficam sem assistente (a contagem dele sai com ele)
        foreach (var o in linhas) o.GolsAssistidos.RemoveAll(g => g.Assistente == l.AtletaId);
        foreach (var gol in lances.Where(x => x.AssistenteId == l.AtletaId)) gol.AssistenteId = null;

        linhas.Remove(l);
        lances.RemoveAll(x => x.AtletaId == l.AtletaId);
        if (confirmados.Remove(l.AtletaId)) camisasPendentes = true;
        Marcar();
    }

    /// <summary>Quem ainda não tem camisa definida guarda um número provisório (o banco exige um). Aqui ele sai da frente dos números definidos.</summary>
    private void AjustarProvisorios(string ld)
    {
        var usados = linhas.Where(l => l.Lado == ld && confirmados.Contains(l.AtletaId)).Select(l => l.Numero).ToHashSet();
        foreach (var l in linhas.Where(x => x.Lado == ld && !confirmados.Contains(x.AtletaId)))
        {
            if (usados.Contains(l.Numero))
            {
                var n = 1;
                while (usados.Contains(n)) n++;
                l.Numero = n;
            }
            usados.Add(l.Numero);
        }
    }

    private void MudarNumero(LinhaSumula l, ChangeEventArgs e)
    {
        erroCamisas = avisoCamisas = null;
        var texto = e.Value?.ToString()?.Trim();

        if (string.IsNullOrEmpty(texto))
        {
            // campo apagado: volta a "sem camisa"
            if (confirmados.Remove(l.AtletaId)) { camisasPendentes = true; AjustarProvisorios(l.Lado); Marcar(); }
            return;
        }

        if (!int.TryParse(texto, out var n) || n < 1)
        {
            erroCamisas = "Informe um número de camisa válido (1 ou mais).";
            return;
        }

        l.Numero = n;
        novos.Remove(l.AtletaId);
        confirmados.Add(l.AtletaId);
        camisasPendentes = true;
        AjustarProvisorios(l.Lado);

        var outro = linhas.FirstOrDefault(o => o != l && o.Lado == l.Lado && o.Numero == n && confirmados.Contains(o.AtletaId));
        if (outro is not null) erroCamisas = $"A camisa {n} já está com {outro.Nome} neste time.";
        Marcar();
    }

    /// <summary>Grava no banco as camisas definidas (só quem tem camisa; o resto fica sem). Não mexe em gols nem cartões.</summary>
    private async Task SalvarCamisas()
    {
        erroCamisas = avisoCamisas = null;

        var comCamisa = linhas.Where(l => confirmados.Contains(l.AtletaId)).ToList();
        var repetido = comCamisa.GroupBy(l => (l.Lado, l.Numero)).FirstOrDefault(g => g.Count() > 1);
        if (repetido is not null)
        {
            erroCamisas = $"A camisa {repetido.Key.Numero} está repetida no time {TimePelada.Rotulo(repetido.Key.Lado)}.";
            return;
        }

        salvando = true;
        try
        {
            await Servico.SalvarCamisasAsync(partida!.Id, comCamisa);
            camisasPendentes = false;
            avisoCamisas = comCamisa.Count == 0 ? "Nenhuma camisa definida." : $"Camisas salvas ({comCamisa.Count}).";
        }
        catch (ErroAdminException ex) { erroCamisas = ex.Message; }
        salvando = false;
    }

    private async Task Salvar()
    {
        erro = aviso = null;

        var repetido = linhas.GroupBy(l => (l.Lado, l.Numero)).FirstOrDefault(g => g.Count() > 1);
        if (repetido is not null)
        {
            erro = $"O número {repetido.Key.Numero} está repetido no time {TimePelada.Rotulo(repetido.Key.Lado)}.";
            return;
        }

        salvando = true;
        try
        {
            // O banco não aceita alterar súmula de partida finalizada: reabre, salva e finaliza de novo (placar e pontos recalculam)
            var refinalizar = partida!.Finalizada && !statusMudou;
            if (refinalizar) await Servico.ReabrirPartidaAsync(partida.Id);
            try
            {
                await Servico.SalvarSumulaAsync(partida.Id, linhas, statusMudou ? status : null);
            }
            finally
            {
                if (refinalizar) await Servico.FinalizarPartidaAsync(partida.Id);   // mesmo se o salvar falhar, a partida não fica aberta
            }
            if (statusMudou) partida.Status = status;
            sujo = statusMudou = false;
            aviso = refinalizar ? "Súmula salva. A partida foi reaberta e finalizada de novo." : "Súmula salva.";

            if (camisasPendentes)
            {
                try
                {
                    await Servico.SalvarCamisasAsync(partida.Id, linhas.Where(l => confirmados.Contains(l.AtletaId)));
                    camisasPendentes = false;
                }
                catch (ErroAdminException ex)
                {
                    aviso = null;
                    erro = "Súmula salva, mas as camisas não: " + ex.Message;
                }
            }
        }
        catch (ErroAdminException ex) { erro = ex.Message; }
        salvando = false;
    }
}
