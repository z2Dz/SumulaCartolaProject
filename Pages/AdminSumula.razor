    private async Task RegistrarEAdicionar()
    {
        erroModal = null;
        if (string.IsNullOrWhiteSpace(novoNome)) { erroModal = "Informe o nome do atleta."; return; }
        if (novasPosicoes.Count == 0) { erroModal = "Escolha ao menos uma posição."; return; }
        if (ProximoNumero(lado) == 0) { erroModal = $"O time {TimePelada.Rotulo(lado)} já tem {LinhaSumula.MaxNumero} atletas."; return; }

        registrando = true;
        try
        {
            string? url = fotoBytes is null ? null : await Servico.EnviarFotoAsync(fotoBytes);
            var posicoes = PosicoesAtleta.Todas.Select(p => p.Sigla).Where(novasPosicoes.Contains);
            var novo = await Servico.RegistrarAtletaAsync(novoNome.Trim(), posicoes, url);
            atletas.Add(novo);
            AdicionarLinha(novo, lado);
            Marcar();
            aviso = $"{novo.Nome} registrado e adicionado ao time {TimePelada.Rotulo(lado)}. Salve a súmula.";
            LimparNovo();
            modal = false;
        }
        catch (ErroAdminException ex) { erroModal = ex.Message; }
        registrando = false;
    }

    private void Remover(LinhaSumula l)
    {
        // gols dele que tinham assistência: a assistência do colega sai junto
        foreach (var gol in lances.Where(x => x.AtletaId == l.AtletaId && x.AssistenteId is not null).ToList())
            if (linhas.FirstOrDefault(x => x.AtletaId == gol.AssistenteId) is { } colega)
                Ajustar(colega, TipoLance.Assistencia, gol.Tempo, -1);
        // gols de outros que ele assistiu: ficam sem assistente (a contagem dele sai com ele)
        foreach (var o in linhas) o.GolsAssistidos.RemoveAll(g => g.Assistente == l.AtletaId);
        foreach (var gol in lances.Where(x => x.AssistenteId == l.AtletaId)) gol.AssistenteId = null;

        linhas.Remove(l);
        lances.RemoveAll(x => x.AtletaId == l.AtletaId);
        if (confirmados.Remove(l.AtletaId)) camisasPendentes = true;
        Marcar();
    }

    /// <summary>Quem ainda não tem camisa definida guarda um número provisório (o banco exige um). Aqui ele sai da frente dos números definidos.</summary>
    private void AjustarProvisorios(string ld)
    {
        var usados = linhas.Where(l => l.Lado == ld && confirmados.Contains(l.AtletaId)).Select(l => l.Numero).ToHashSet();
        foreach (var l in linhas.Where(x => x.Lado == ld && !confirmados.Contains(x.AtletaId)))
        {
            if (usados.Contains(l.Numero))
            {
                var n = 1;
                while (usados.Contains(n)) n++;
                l.Numero = n;
            }
            usados.Add(l.Numero);
        }
    }

    private void MudarNumero(LinhaSumula l, ChangeEventArgs e)
    {
        erroCamisas = avisoCamisas = null;
        var texto = e.Value?.ToString()?.Trim();

        if (string.IsNullOrEmpty(texto))
        {
            // campo apagado: volta a "sem camisa"
            if (confirmados.Remove(l.AtletaId)) { camisasPendentes = true; AjustarProvisorios(l.Lado); Marcar(); }
            return;
        }

        if (!int.TryParse(texto, out var n) || n < 1)
        {
            erroCamisas = "Informe um número de camisa válido (1 ou mais).";
            return;
        }

        l.Numero = n;
        novos.Remove(l.AtletaId);
        confirmados.Add(l.AtletaId);
        camisasPendentes = true;
        AjustarProvisorios(l.Lado);

        var outro = linhas.FirstOrDefault(o => o != l && o.Lado == l.Lado && o.Numero == n && confirmados.Contains(o.AtletaId));
        if (outro is not null) erroCamisas = $"A camisa {n} já está com {outro.Nome} neste time.";
        Marcar();
    }

    /// <summary>Grava no banco as camisas definidas (só quem tem camisa; o resto fica sem). Não mexe em gols nem cartões.</summary>
    private async Task SalvarCamisas()
    {
        erroCamisas = avisoCamisas = null;

        var comCamisa = linhas.Where(l => confirmados.Contains(l.AtletaId)).ToList();
        var repetido = comCamisa.GroupBy(l => (l.Lado, l.Numero)).FirstOrDefault(g => g.Count() > 1);
        if (repetido is not null)
        {
            erroCamisas = $"A camisa {repetido.Key.Numero} está repetida no time {TimePelada.Rotulo(repetido.Key.Lado)}.";
            return;
        }

        salvando = true;
        try
        {
            await Servico.SalvarCamisasAsync(partida!.Id, comCamisa);
            camisasPendentes = false;
            avisoCamisas = comCamisa.Count == 0 ? "Nenhuma camisa definida." : $"Camisas salvas ({comCamisa.Count}).";
        }
        catch (ErroAdminException ex) { erroCamisas = ex.Message; }
        salvando = false;
    }

    private async Task Salvar()
    {
        erro = aviso = null;

        var repetido = linhas.GroupBy(l => (l.Lado, l.Numero)).FirstOrDefault(g => g.Count() > 1);
        if (repetido is not null)
        {
            erro = $"O número {repetido.Key.Numero} está repetido no time {TimePelada.Rotulo(repetido.Key.Lado)}.";
            return;
        }

        salvando = true;
        try
        {
            // O banco não aceita alterar súmula de partida finalizada: reabre, salva e finaliza de novo (placar e pontos recalculam)
            var refinalizar = partida!.Finalizada && !statusMudou;
            if (refinalizar) await Servico.ReabrirPartidaAsync(partida.Id);
            try
            {
                await Servico.SalvarSumulaAsync(partida.Id, linhas, statusMudou ? status : null);
            }
            finally
            {
                if (refinalizar) await Servico.FinalizarPartidaAsync(partida.Id);   // mesmo se o salvar falhar, a partida não fica aberta
            }
            if (statusMudou) partida.Status = status;
            sujo = statusMudou = false;
            aviso = refinalizar ? "Súmula salva. A partida foi reaberta e finalizada de novo." : "Súmula salva.";

            if (camisasPendentes)
            {
                try
                {
                    await Servico.SalvarCamisasAsync(partida.Id, linhas.Where(l => confirmados.Contains(l.AtletaId)));
                    camisasPendentes = false;
                }
                catch (ErroAdminException ex)
                {
                    aviso = null;
                    erro = "Súmula salva, mas as camisas não: " + ex.Message;
                }
            }
        }
        catch (ErroAdminException ex) { erro = ex.Message; }
        salvando = false;
    }
}
