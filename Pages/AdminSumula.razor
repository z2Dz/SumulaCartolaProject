@page "/admin/sumula"
@attribute [Authorize(Roles = "admin")]
@inject ServicoSumula Servico

<PageTitle>Súmula · Cartola dos Amigos</PageTitle>

<div class="pagina adm fixa sm2">
    <a class="adm-voltar sm2-voltar" href="admin/cartola"><IconeUi Nome="voltar" Tamanho="16" /> Partidas</a>
    <h1>Súmula</h1>

    @if (carregando)
    {
        <p class="suave">Carregando…</p>
    }
    else if (partida is null)
    {
        @if (!string.IsNullOrEmpty(erro))
        {
            <p class="erro">@erro</p>
        }
        else
        {

            <div class="cartao"><p class="suave">Nenhuma partida cadastrada ainda.</p></div>
        }
    }
    else
    {
        <div class="sm2-filtros">
            <span class="sm2-cal"><IconeUi Nome="calendario" Tamanho="26" /></span>
            <label class="sm2-campo sm2-rodada" for="partida">
                <small>Rodada</small>
                <select id="partida" disabled="@sujo" @onchange="AoTrocarPartida">
                    @foreach (var p in partidas)
                    {
                        <option value="@p.Id" selected="@(p.Id == partida.Id)">@p.Titulo</option>
                    }
                </select>
            </label>
            <label class="sm2-campo sm2-status" for="status">
                <small>Status</small>
                <span class="sm2-dot @status"></span>
                <select id="status" value="@status" @onchange="AoTrocarStatus">
                    <option value="agendada">Agendada</option>
                    <option value="em_andamento">Em andamento</option>
                    <option value="finalizada">Finalizada</option>
                    <option value="cancelada">Cancelada</option>
                </select>
            </label>
            @if (sujo)
            {
                <span class="sm2-aviso-sujo">Salve ou descarte para trocar de rodada.</span>
            }
            <span class="sm2-barra-gap"></span>
            <button type="button" class="sm2-add" disabled="@partida.Finalizada" @onclick="AbrirTrocas"><IconeUi Nome="pessoas" Tamanho="18" /> Substituições</button>
            <button type="button" class="sm2-add" @onclick="AbrirModal"><IconeUi Nome="mais" Tamanho="18" /> Adicionar atleta</button>
        </div>

        <div class="sm2-placar" aria-label="Placar">
            <img src="img/time-vermelho.png" alt="" />
            <span class="sm2-nome">Vermelho</span>
            <strong>@GolsDoLado(LinhaSumula.Casa)</strong>
            <span class="sm2-x">x</span>
            <strong>@GolsDoLado(LinhaSumula.Visitante)</strong>
            <span class="sm2-nome">Amarelo</span>
            <img src="img/time-amarelo.png" alt="" />
        </div>

        @if (!string.IsNullOrEmpty(erro))
        {
            <p class="erro">@erro</p>
        }
        @if (!string.IsNullOrEmpty(aviso))
        {
            <p class="adm-ok">@aviso</p>
        }
        @if (partida.Finalizada && !statusMudou)
        {
            <p class="adm-dica">Partida finalizada. Ao salvar, ela é reaberta e finalizada de novo para recalcular placar e pontos.</p>
        }

        <div class="adm-abas sm2-abas">
            <button type="button" class="vermelho" @onclick="() => AbrirLance(LinhaSumula.Casa)">
                <img src="img/time-vermelho.png" alt="" /> Vermelho <IconeUi Nome="mais" Tamanho="16" />
            </button>
            <button type="button" class="amarelo" @onclick="() => AbrirLance(LinhaSumula.Visitante)">
                <img src="img/time-amarelo.png" alt="" /> Amarelo <IconeUi Nome="mais" Tamanho="16" />
            </button>
        </div>

        <div class="sm2-lista">
            @{
                var itens = LinhaDoTempo();
            }
            <div class="sm2-tl" aria-label="Linha do tempo da partida">
                @foreach (var it in itens)
                {
                    var lc = it.Ev;
                    var num = NumeroDe(lc.AtletaId);
                    <div class="sm2-tl-item @(lc.Lado == LinhaSumula.Casa ? "sm2-tl-esq" : "sm2-tl-dir") @ClasseTipo(lc.Tipo)" @key="lc.Id">
                        <div class="sm2-tl-no">
                            @if (EhGol(lc.Tipo))
                            {
                                <span>@($"{it.Casa}-{it.Visitante}")</span>
                                <IconeUi Nome="bola" Tamanho="14" />
                            }
                            else
                            {
                                <span>@TempoTxt(lc)</span>
                            }
                        </div>
                        <div class="sm2-tl-txt">
                            <div class="sm2-tl-corpo">
                                <span class="sm2-tl-chips">
                                    <span class="sm2-tl-tempo">@TempoTxt(lc)</span>
                                    @if (num is not null)
                                    {
                                        <span class="sm2-tl-num" title="Camisa neste jogo">@num</span>
                                    }
                                    <button type="button" class="sm2-tl-edit" title="Editar lance" aria-label="Editar lance" @onclick="() => AbrirEdicao(lc)">✎</button>
                                    <button type="button" class="sm2-tl-x" title="Desfazer lance" aria-label="Desfazer lance" @onclick="() => DesfazerLance(lc)">✕</button>
                                </span>
                                <span class="sm2-tl-nomes">
                                    <strong>@NomeDe(lc.AtletaId)</strong>
                                    @if (lc.AssistenteId is { } idAss)
                                    {
                                        <span class="sm2-tl-assist" title="Assistência">@NomeDe(idAss)</span>
                                    }
                                </span>
                                <small class="sm2-tl-sub">@RotuloDe(lc.Tipo)</small>
                            </div>
                            @if (ArquivoIcone(lc.Tipo) is not null)
                            {
                                <div class="sm2-tl-ico" aria-hidden="true">
                                    <img class="sm2-tl-img" src="@CaminhoIcone(lc.Tipo)" alt="" draggable="false" />
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (itens.Count == 0)
                {
                    <p class="suave sm2-vazio">Nenhum lance ainda. Toque em Vermelho ou Amarelo para registrar gol ou cartão.</p>
                }
            </div>
            @if (lances.Any(x => x.Reconstruido))
            {
                <p class="adm-dica">Ao reabrir uma súmula salva, o banco lembra o tempo (1T/2T) de cada lance, mas não a ordem dentro do tempo (ela é aproximada). Lances antigos, gravados sem tempo, aparecem com — no início da linha.</p>
            }
        </div>

        <div class="sm2-barra">
            <span class="sm2-barra-gap"></span>
            @if (sujo || statusMudou)
            {
                <button type="button" class="sm2-sec" @onclick="Descartar">Descartar</button>
            }
            <button type="button" class="sm2-salvar" disabled="@(!sujo && !statusMudou || salvando)" @onclick="Salvar">
                @(salvando ? "Salvando…" : "Salvar súmula")
            </button>
        </div>

        @if (modalLance)
        {
            var jogadores = LinhasDe(lado).ToList();
            var faltam = SemCamisa(lado);
            <div class="previa-fundo" @onclick="FecharLance">
                <div class="previa previa-lance" role="dialog" aria-modal="true" aria-label="Registrar lance" @onclick:stopPropagation="true">
                    <div class="previa-topo">
                        <h3>@TimePelada.Rotulo(lado) (@Contar(lado))</h3>
                        <button type="button" class="adm-icone" @onclick="FecharLance" aria-label="Fechar">✕</button>
                    </div>

                    <div class="adm-seg adm-seg-largo sm2-seg" role="tablist" aria-label="Seção do popup">
                        <button type="button" role="tab" aria-selected="@(!abaLista)" class="@TimePelada.Css(lado) @(!abaLista ? "on" : "")" @onclick="() => abaLista = false">Ações do jogo</button>
                        <button type="button" role="tab" aria-selected="@abaLista" class="@TimePelada.Css(lado) @(abaLista ? "on" : "")" @onclick="() => abaLista = true">
                            Lista do time
                            @if (faltam > 0)
                            {
                                <span class="sm2-papel sai" title="Camisas sem número definido">⚠ @faltam</span>
                            }
                        </button>
                    </div>

                    @if (abaLista)
                    {
                        var papeis = PapeisDe(lado);
                        @if (camisasIndisponivel)
                        {
                            <p class="erro">As camisas por partida ainda não estão ativas no banco. Rode o arquivo camisas_por_partida.sql no Supabase.</p>
                        }
                        @if (faltam > 0)
                        {
                            <span class="sm2-papel sai" role="status">⚠ Faltam @faltam número(s) de camisa neste time</span>
                        }
                        else if (jogadores.Count > 0)
                        {
                            <span class="sm2-papel titular" role="status">✓ Todas as camisas definidas</span>
                        }
                        @if (camisasPendentes)
                        {
                            <span class="sm2-papel sai" role="status">● Camisas alteradas, ainda não salvas</span>
                        }
                        <span class="adm-rotulo">Na ordem de chegada. A camisa só fica preenchida depois de salva. O ✕ tira o atleta da súmula.</span>
                        <ul class="chg-nomes">
                            @foreach (var j in jogadores)
                            {
                                var jog = j;
                                var atl = atletas.FirstOrDefault(a => a.Id == jog.AtletaId);
                                var goleiro = EhGoleiro(jog.AtletaId);
                                <li @key="jog.AtletaId">
                                    <label class="sm2-camisa @TimePelada.Css(jog.Lado) @(confirmados.Contains(jog.AtletaId) ? "" : "vazio")" title="Número da camisa neste jogo">
                                        <svg viewBox="0 0 64 64" aria-hidden="true"><path d="M22 6 L8 12 L2 26 L12 31 L16 26 L16 58 L48 58 L48 26 L52 31 L62 26 L56 12 L42 6 C40 11 36 13 32 13 C28 13 24 11 22 6 Z" /></svg>
                                        <input type="number" min="1" inputmode="numeric"
                                               value="@(confirmados.Contains(jog.AtletaId) ? jog.Numero.ToString() : "")" @onchange="e => MudarNumero(jog, e)" placeholder="Nº" aria-label="Número da camisa" />
                                        @if (!confirmados.Contains(jog.AtletaId))
                                        {
                                            <span class="sm2-camisa-dica" aria-hidden="true">✎</span>
                                        }
                                    </label>
                                    <FotoJogador Nome="@jog.Nome" FotoUrl="@atl?.FotoUrl" Posicoes="@atl?.Posicoes" Tamanho="32" />
                                    <span class="chg-nome-txt">
                                        <strong>@jog.Nome</strong>
                                        @if (goleiro)
                                        {
                                            <small>Goleiro</small>
                                        }
                                        else if (papeis.TryGetValue(jog.AtletaId, out var papel))
                                        {
                                            <small>@papel.Rotulo</small>
                                        }
                                    </span>
                                    <button type="button" class="sm2-remover" @onclick="() => Remover(jog)" aria-label="Tirar @jog.Nome da súmula" title="Tirar da súmula">✕</button>
                                </li>
                            }
                        </ul>
                        @if (jogadores.Count == 0)
                        {
                            <p class="suave sm2-vazio">Nenhum atleta neste time. Registre a chegada na <a href="admin/chegada?partida=@partida.Id">ordem de chegada</a> ou use o botão abaixo.</p>
                        }
                        @if (!string.IsNullOrEmpty(erroCamisas))
                        {
                            <p class="erro">@erroCamisas</p>
                        }
                        @if (!string.IsNullOrEmpty(avisoCamisas))
                        {
                            <p class="adm-ok">@avisoCamisas</p>
                        }
                        <div class="sm2-barra">
                            <button type="button" class="sm2-add" @onclick="AbrirAdicionarDoLance"><IconeUi Nome="mais" Tamanho="18" /> Adicionar atleta</button>
                            <span class="sm2-barra-gap"></span>
                            <button type="button" class="sm2-salvar" disabled="@(!camisasPendentes || salvando || camisasIndisponivel)" @onclick="SalvarCamisas">
                                @(salvando ? "Salvando…" : "Salvar camisas")
                            </button>
                        </div>
                    }
                    else if (acaoLance is null)
                    {
                        @* Passo 1: o que aconteceu (e em que tempo) *@
                        <span class="adm-rotulo">Tempo</span>
                        <div class="adm-seg adm-seg-largo sm2-seg" role="group" aria-label="Tempo do lance">
                            <button type="button" class="@TimePelada.Css(lado) @(tempoLance == 1 ? "on" : "")" aria-pressed="@(tempoLance == 1)" @onclick="() => tempoLance = 1">1º tempo</button>
                            <button type="button" class="@TimePelada.Css(lado) @(tempoLance == 2 ? "on" : "")" aria-pressed="@(tempoLance == 2)" @onclick="() => tempoLance = 2">2º tempo</button>
                        </div>

                        <span class="adm-rotulo">O que foi o lance?</span>
                        <div class="sm2-acoes sm2-acoes-grade">
                            @foreach (var ta in AcoesDoLance)
                            {
                                var tipoAcao = ta;
                                <button type="button" class="sm2-acao @ClasseAcao(tipoAcao)" @onclick="() => EscolherAcao(tipoAcao)">
                                    <img class="sm2-acao-img" src="@CaminhoIcone(tipoAcao)" alt="" draggable="false" />
                                    <span>@RotuloDe(tipoAcao)</span>
                                </button>
                            }
                        </div>
                    }
                    else if (jogadorLance is null)
                    {
                        @* Passo 2: quem fez o lance (as demais ações registram assim que o jogador é escolhido) *@
                        <div class="chg-nome">
                            <span class="chg-nome-txt">
                                <strong>@RotuloDe(acaoLance.Value)</strong>
                                <small>@(tempoLance)º tempo</small>
                            </span>
                            <button type="button" class="botao-sec" @onclick="TrocarAcao">Trocar</button>
                        </div>

                        <span class="adm-rotulo">Quem fez o lance?</span>
                        <ul class="sm2-cards">
                            @foreach (var j in jogadores)
                            {
                                var jog = j;
                                var atl = atletas.FirstOrDefault(a => a.Id == jog.AtletaId);
                                <li>
                                    <button type="button" class="sm2-card-jog" @onclick="() => EscolherJogador(jog.AtletaId)">
                                        <span class="sm2-card-foto"><FotoJogador Nome="@jog.Nome" FotoUrl="@atl?.FotoUrl" Posicoes="@atl?.Posicoes" Tamanho="64" /></span>
                                        <strong>@jog.Nome</strong>
                                        <small>@InfoJogador(jog, atl?.Posicoes)</small>
                                    </button>
                                </li>
                            }
                        </ul>
                        @if (jogadores.Count == 0)
                        {
                            <p class="suave sm2-vazio">Nenhum atleta neste time ainda.</p>
                            <button type="button" class="sm2-add" @onclick="() => abaLista = true"><IconeUi Nome="mais" Tamanho="18" /> Ir para a lista do time</button>
                        }
                    }
                    else
                    {
                        @* Passo 3 (só para gol): assistência opcional *@
                        var atual = linhas.FirstOrDefault(x => x.AtletaId == jogadorLance);
                        var atlAtual = atletas.FirstOrDefault(a => a.Id == jogadorLance);
                        @if (atual is null)
                        {
                            <p class="suave">Atleta não encontrado.</p>
                        }
                        else
                        {
                            <div class="chg-nome">
                                <FotoJogador Nome="@atual.Nome" FotoUrl="@atlAtual?.FotoUrl" Posicoes="@atlAtual?.Posicoes" Tamanho="32" />
                                <span class="chg-nome-txt">
                                    <strong>@atual.Nome</strong>
                                    <small>Gol · @(tempoLance)º tempo</small>
                                </span>
                                <button type="button" class="botao-sec" @onclick="TrocarJogador">Trocar</button>
                            </div>

                            <span class="adm-rotulo">Quem deu a assistência? (opcional)</span>
                            <ul class="sm2-cards">
                                @foreach (var j in jogadores.Where(x => x.AtletaId != jogadorLance))
                                {
                                    var jog = j;
                                    var atl = atletas.FirstOrDefault(a => a.Id == jog.AtletaId);
                                    <li>
                                        <button type="button" class="sm2-card-jog" aria-pressed="@(assistLance == jog.AtletaId)" @onclick="() => AlternarAssist(jog.AtletaId)">
                                            @if (assistLance == jog.AtletaId)
                                            {
                                                <span class="sm2-card-ok" aria-hidden="true">✓</span>
                                            }
                                            <span class="sm2-card-foto"><FotoJogador Nome="@jog.Nome" FotoUrl="@atl?.FotoUrl" Posicoes="@atl?.Posicoes" Tamanho="64" /></span>
                                            <strong>@jog.Nome</strong>
                                            <small>@InfoJogador(jog, atl?.Posicoes)</small>
                                        </button>
                                    </li>
                                }
                            </ul>
                            <div class="sm2-barra">
                                <button type="button" class="sm2-sec" @onclick="TrocarJogador">Voltar</button>
                                <span class="sm2-barra-gap"></span>
                                <button type="button" class="sm2-salvar" @onclick="() => RegistrarLance(TipoLance.Gol, assistLance)">
                                    @(assistLance is null ? "Registrar gol" : "Registrar gol com assistência")
                                </button>
                            </div>
                        }
                    }
                </div>
            </div>
        }

        @if (lanceEditando is not null)
        {
            <div class="previa-fundo" @onclick="FecharEdicao">
                <div class="previa" role="dialog" aria-modal="true" aria-label="Editar lance" @onclick:stopPropagation="true">
                    <div class="previa-topo">
                        <h3>Editar lance</h3>
                        <button type="button" class="adm-icone" @onclick="FecharEdicao" aria-label="Fechar">✕</button>
                    </div>

                    <label class="sm2-campo" for="edit-atleta">
                        <small>Atleta</small>
                        <select id="edit-atleta" @bind="editAtleta">
                            @foreach (var j in linhas.OrderBy(x => x.Lado).ThenBy(x => x.Nome))
                            {
                                <option value="@j.AtletaId">@j.Nome (@TimePelada.Rotulo(j.Lado))</option>
                            }
                        </select>
                    </label>

                    <label class="sm2-campo" for="edit-tipo">
                        <small>Lance</small>
                        <select id="edit-tipo" @bind="editTipo">
                            @foreach (var t in Enum.GetValues<TipoLance>())
                            {
                                <option value="@t">@RotuloDe(t)</option>
                            }
                        </select>
                    </label>

                    @if (editTipo == TipoLance.Gol)
                    {
                        var ladoEdit = linhas.FirstOrDefault(y => y.AtletaId == editAtleta)?.Lado ?? lanceEditando.Lado;
                        <label class="sm2-campo" for="edit-assist">
                            <small>Assistência</small>
                            <select id="edit-assist" @bind="editAssist">
                                <option value="">Sem assistência</option>
                                @foreach (var j in linhas.Where(x => x.Lado == ladoEdit && x.AtletaId != editAtleta).OrderBy(x => x.Nome))
                                {
                                    <option value="@j.AtletaId">@j.Nome</option>
                                }
                            </select>
                        </label>
                    }

                    <span class="adm-rotulo">Tempo</span>
                    <div class="adm-seg adm-seg-largo sm2-seg" role="group" aria-label="Tempo do lance">
                        <button type="button" class="@TimePelada.Css(lanceEditando.Lado) @(editTempo == 1 ? "on" : "")" aria-pressed="@(editTempo == 1)" @onclick="() => editTempo = 1">1º tempo</button>
                        <button type="button" class="@TimePelada.Css(lanceEditando.Lado) @(editTempo == 2 ? "on" : "")" aria-pressed="@(editTempo == 2)" @onclick="() => editTempo = 2">2º tempo</button>
                        @if (!ComTempo.Contains(editTipo))
                        {
                            <button type="button" class="@TimePelada.Css(lanceEditando.Lado) @(editTempo == 0 ? "on" : "")" aria-pressed="@(editTempo == 0)" @onclick="() => editTempo = 0">Sem tempo</button>
                        }
                    </div>

                    <div class="sm2-barra">
                        <button type="button" class="sm2-sec" @onclick="FecharEdicao">Cancelar</button>
                        <span class="sm2-barra-gap"></span>
                        <button type="button" class="sm2-salvar" @onclick="SalvarEdicao">Aplicar</button>
                    </div>
                </div>
            </div>
        }

        @if (popupTrocas)
        {
            <div class="previa-fundo" @onclick="FecharTrocas">
                <div class="previa previa-larga tr-pop" role="dialog" aria-modal="true" aria-label="Substituições" @onclick:stopPropagation="true">
                    <div class="previa-topo">
                        <h3>Substituições</h3>
                        <div class="previa-acoes">
                            <button type="button" class="adm-icone" @onclick="FecharTrocas" aria-label="Fechar">✕</button>
                        </div>
                    </div>
                    <p class="suave tr-dica">
                        Arraste um atleta da lista (ou toque nele e depois no destino) para cima de quem sai ou de quem entra: os dois trocam de lugar.
                        @if (salvandoTrocas) { <span> Salvando…</span> }
                    </p>
                    @if (!string.IsNullOrEmpty(erroTrocas))
                    {
                        <p class="erro">@erroTrocas</p>
                    }
                    <div class="tr-abas" role="tablist" aria-label="Time">
                        @foreach (var ladoAba in new[] { LinhaSumula.Casa, LinhaSumula.Visitante })
                        {
                            var l = ladoAba;
                            <button type="button" role="tab" aria-selected="@(abaTrocas == l)" class="@TimePelada.Css(l) @(abaTrocas == l ? "ativa" : "")" @onclick="() => TrocarAbaTrocas(l)">
                                <span class="adm-bolinha @TimePelada.Css(l)"></span> @TimePelada.Rotulo(l)
                            </button>
                        }
                    </div>
                    <div class="tr-time">
                        @{
                            var ladoTroca = abaTrocas;
                            var goleirosTroca = atletas.Where(AnaliseTime.EhSoGoleiro).Select(a => a.Id).ToHashSet();
                            var todosTroca = LinhasDe(ladoTroca)
                                .Where(l => !goleirosTroca.Contains(l.AtletaId))
                                .Select(l => atletas.FirstOrDefault(a => a.Id == l.AtletaId) ?? new AtletaResumo { Id = l.AtletaId, Nome = l.Nome })
                                .ToList();
                            var planoTroca = PlanoDe(ladoTroca);
                            var trocas = planoTroca.Trocas.ToList();
                            var nosSlots = trocas.SelectMany(t => new[] { t.Sai.Id, t.Entra.Id }).ToHashSet();
                            var restantes = todosTroca.Where(j => !nosSlots.Contains(j.Id)).ToList();
                            <section class="previa-time @TimePelada.Css(ladoTroca)">
                                <h4><span class="adm-bolinha @TimePelada.Css(ladoTroca)"></span> @TimePelada.Rotulo(ladoTroca) (@todosTroca.Count)</h4>

                                <h5 class="tr-titulo">Substituições do 2º tempo (@trocas.Count)</h5>
                                @if (trocas.Count == 0)
                                {
                                    <p class="suave">Sem substituições: o time não tem reservas.</p>
                                }
                                <div class="tr-pares">
                                    @foreach (var t in trocas)
                                    {
                                        <div class="tr-par">
                                            <CartaoTroca Atleta="t.Sai" Papel="sai" Selecionado="@(selecionadoTroca == t.Sai.Id)" Arrastando="@(arrastandoTroca == t.Sai.Id)" Desabilitado="@(partida.Finalizada || salvandoTrocas)"
