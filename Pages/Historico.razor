@page "/historico"
@using SumulaCartolaProject.Models
@using SumulaCartolaProject.Servicos
@inject ServicoHistorico Servico
@inject ServicoTemporada ServicoTemp
@using System.Globalization

<PageTitle>Histórico de gols</PageTitle>

<div class="hist">
    <h1 class="hist-d">Histórico de gols</h1>
    <p class="hist-sub hist-d">Artilheiros da pelada desde 2008</p>

    @if (carregando)
    {
        <p class="hist-msg">Carregando histórico…</p>
    }
    else if (erro is not null)
    {
        <p class="hist-msg hist-erro">@erro</p>
        <button class="hist-btn" @onclick="Carregar">Tentar de novo</button>
    }
    else
    {
        var porAtleta = ResumoPorAtleta;
        var tabela = LinhasTabela(porAtleta);
        <div class="hist-m">
            <a class="m-voltar" href="/">‹ Início</a>
            <h1 class="m-h1">Histórico de gols</h1>
            <p class="m-sub">Artilheiros da pelada desde 2008</p>

            <div class="m-pills">
                <button class="@(Aba == 0 ? "on" : "")" @onclick="() => Aba = 0">Geral</button>
                @foreach (var a in anos)
                {
                    var ano = a;
                    <button class="@(Aba == ano ? "on" : "")" @onclick="() => Aba = ano">@ano</button>
                }
            </div>

            <div class="m-cards">
                <div>
                    <i class="ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2"/><path fill="currentColor" d="M12 7.5l3.2 2.3-1.2 3.8h-4l-1.2-3.8z"/></svg></i>
                    <span><b>@totalGols.ToString("N0")</b><small>gols @(Aba == 0 ? "no histórico" : "em " + Aba)</small></span>
                </div>
                <div>
                    <i class="ic"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2" fill="currentColor"/><circle cx="17" cy="9" r="2.5" fill="currentColor" opacity=".7"/><path fill="currentColor" d="M3 19c0-3.3 2.7-5.5 6-5.5s6 2.200 6 5.500zM15.500 14c2.600 0 5.500 1.600 5.500 5h-4.200c0-1.900-.6-3.600-1.300-5z"/></svg></i>
                    <span><b>@Linhas.Count</b><small>jogadores</small></span>
                </div>
                <div class="gold">
                    <i class="ic"><svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2.500l2.900 6 6.600.9-4.800 4.600 1.200 6.500L12 17.300 6.100 20.500l1.200-6.500L2.500 9.400l6.600-.9z"/></svg></i>
                    <span><b>@(Linhas.Count > 0 ? Linhas[0].Nome : "—")</b><small>artilheiro@(Linhas.Count > 0 ? " (" + Linhas[0].Gols + ")" : "")</small></span>
                </div>
            </div>

            <div class="m-filtro">
                <input type="search" placeholder="Buscar jogador" @bind="busca" @bind:event="oninput" />
                <select @bind="filtro">
                    <option value="todos">Todos</option>
                    <option value="ativos">Só ativos</option>
                    <option value="inativos">Só inativos</option>
                </select>
            </div>

            <div class="m-tabela @(EhTemporadaAtual ? "" : "so-gols")">
                <div class="m-row m-head">
                    <span class="c-pos">#</span>
                    <span class="c-nome">JOGADOR</span>
                    <span class="c-n ord @Ord("v") t-v" title="Jogos no Vermelho (clique para ordenar)" @onclick='() => Ordenar("v")'>V</span>
                    <span class="c-n ord @Ord("a") t-a" title="Jogos no Amarelo (clique para ordenar)" @onclick='() => Ordenar("a")'>A</span>
                    <span class="c-n ord @Ord("am")" title="Cartões amarelos (clique para ordenar)" @onclick='() => Ordenar("am")'><u class="cart am"></u></span>
                    <span class="c-n ord @Ord("az")" title="Cartões azuis (clique para ordenar)" @onclick='() => Ordenar("az")'><u class="cart az"></u></span>
                    <span class="c-n ord @Ord("vm")" title="Cartões vermelhos (clique para ordenar)" @onclick='() => Ordenar("vm")'><u class="cart vm"></u></span>
                    <span class="c-m ord @Ord("med")" title="Gols por jogo (clique para ordenar)" @onclick='() => Ordenar("med")'>MÉD</span>
                    <span class="c-n ord @Ord("ast")" title="Assistências (clique para ordenar)" @onclick='() => Ordenar("ast")'>AST</span>
                    <span class="c-n ord @Ord("gc")" title="Gols contra (clique para ordenar)" @onclick='() => Ordenar("gc")'>GC</span>
                    <span class="c-g ord @Ord("gols")" title="Gols (clique para ordenar)" @onclick='() => Ordenar("gols")'>GOLS</span>
                </div>
                <div class="m-corpo">
                    @if (Linhas.Count == 0)
                    {
                        <p class="hist-msg">Nenhum jogador encontrado.</p>
                    }
                    @foreach (var l in tabela)
                    {
                        var r = ResumoDe(l, porAtleta);
                        <div class="m-row @(l.Posicao == 1 ? "p1" : "")">
                            <span class="c-pos">@l.Posicao</span>
                            <span class="c-nome @(l.Ativo ? "" : "off")">@l.Nome</span>
                            <span class="c-n t-v">@(r is null ? "–" : r.JogosVermelho.ToString())</span>
                            <span class="c-n t-a">@(r is null ? "–" : r.JogosAmarelo.ToString())</span>
                            <span class="c-n">@(r is null ? "–" : r.Amarelos.ToString())</span>
                            <span class="c-n">@(r is null ? "–" : r.Azuis.ToString())</span>
                            <span class="c-n">@(r is null ? "–" : r.Vermelhos.ToString())</span>
                            <span class="c-m">@MediaTexto(l, r)</span>
                            <span class="c-n">@(r is null ? "–" : r.Assistencias.ToString())</span>
                            <span class="c-n gc">@(r is null ? "–" : r.GolsContra.ToString())</span>
                            <span class="c-g"><b>@l.Gols</b></span>
                        </div>
                    }
                </div>
            </div>

            <a class="m-cta" href="/escalar">
                <i class="ic"><svg viewBox="0 0 24 24"><path fill="currentColor" d="M7 3h10v2h3v3c0 2.200-1.600 4-3.700 4.300A5 5 0 0 1 13 15.900V18h3v2H8v-2h3v-2.100A5 5 0 0 1 7.700 12.300C5.600 12 4 10.200 4 8V5h3V3zm-1 4v1c0 1 .6 1.800 1.400 2.100A9 9 0 0 1 7 7H6zm12 0h-1c0 1.200-.1 2.300-.4 3.100C17.400 9.800 18 9 18 8V7z"/></svg></i>
                <span><b>O topo te espera!</b><small>Quem será o artilheiro da próxima rodada?</small></span>
                <em>›</em>
            </a>
        </div>

        <div class="hist-corpo @(EhTemporadaAtual ? "" : "sem-lado")">
            @if (EhTemporadaAtual)
            {
                <aside class="hist-lado">
                    <section class="hist-card">
                        <h2><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M3 7l4.5 4L12 4l4.5 7L21 7l-2 11H5L3 7zm2.6 13h12.8v2H5.6v-2z"/></svg>Top 3 da temporada</h2>
                        @if (Top3.Count == 0)
                        {
                            <p class="hist-msg">Sem gols nesta temporada.</p>
                        }
                        @foreach (var l in Top3)
                        {
                            <div class="top3 @(l.Posicao == 1 ? "p1" : "")">
                                <span class="pos">@l.Posicao</span>
                                <span class="av"><SilhuetaAtleta Nome="@l.Nome" /></span>
                                <span class="tx"><b>@l.Nome</b><small>@(l.Ativo ? "Ativo" : "Inativo")</small></span>
                                <span class="gl">@l.Gols</span>
                            </div>
                        }
                    </section>

                    <section class="hist-card">
                        <h2><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M4 20V10h3v10H4zm6 0V4h3v16h-3zm6 0v-7h3v7h-3z"/></svg>Estatísticas</h2>
                        <div class="stats">
                            <div class="stat"><small>Mais gols</small><b>@EstMaisGols.Nome</b><strong>@EstMaisGols.Valor</strong></div>
                            <div class="stat"><small>Melhor média</small><b>@EstMedia.Nome</b><strong>@EstMedia.Valor</strong></div>
                            <div class="stat"><small>Mais jogos</small><b>@EstJogos.Nome</b><strong>@EstJogos.Valor</strong></div>
                            <div class="stat"><small>Mais cartões</small><b>@EstCartoes.Nome</b><strong>@EstCartoes.Valor</strong></div>
                            <div class="stat"><small>Mais assistências</small><b>@EstAssistencias.Nome</b><strong>@EstAssistencias.Valor</strong></div>
                            <div class="stat"><small>Mais gols contra</small><b>@EstGolsContra.Nome</b><strong>@EstGolsContra.Valor</strong></div>
                        </div>
                        <p class="hist-nota">Média = gols por jogo (mínimo de @MinJogosMedia jogos). Jogos, média, cartões, assistências e gols contra vêm da temporada lançada no app. Quem só tem assistências ou gols contra aparece na lista com 0 gols.</p>
                    </section>
                </aside>
            }

            <div class="hist-principal">
                <div class="hist-filtros">
                    <input type="search" placeholder="Buscar jogador" @bind="busca" @bind:event="oninput" />
                    <select @bind="filtro">
                        <option value="todos">Todos</option>
                        <option value="ativos">Só ativos</option>
                        <option value="inativos">Só inativos</option>
                    </select>
                    <select class="hist-ano" @bind="Aba" aria-label="Temporada">
                        <option value="0">Geral</option>
                        @foreach (var a in anos)
                        {
                            <option value="@a">@a</option>
                        }
                    </select>
                </div>

                <div class="hist-resumo">
                    <div><b>@totalGols.ToString("N0")</b><span>gols @(Aba == 0 ? "no histórico" : "em " + Aba)</span></div>
                    <div><b>@Linhas.Count</b><span>jogadores</span></div>
                    @if (Linhas.Count > 0)
                    {
                        <div><b>@Linhas[0].Nome</b><span>artilheiro (@Linhas[0].Gols)</span></div>
                    }
                </div>

                @if (Linhas.Count == 0)
                {
                    <p class="hist-msg">Nenhum jogador encontrado.</p>
                }
                else
                {
                    @if (EhTemporadaAtual)
                    {
                        <div class="hist-cab hist-cab-g" aria-hidden="true">
                            <span class="g1">JOGOS NO TIME</span>
                            <span class="g2">CARTÕES</span>
                            <span class="g3">GOLS/JOGO</span>
                            <span class="g4">OUTROS</span>
                        </div>
                        <div class="hist-cab">
                            <span class="pos">#</span>
                            <span class="nome">JOGADOR</span>
                            <span class="n ord @Ord("v") t-v" title="Jogos no time Vermelho (clique para ordenar)" @onclick='() => Ordenar("v")'>VERM.</span>
                            <span class="n ord @Ord("a") t-a" title="Jogos no time Amarelo (clique para ordenar)" @onclick='() => Ordenar("a")'>AMAR.</span>
                            <span class="n ord @Ord("am")" title="Cartões amarelos (clique para ordenar)" @onclick='() => Ordenar("am")'><u class="cart am"></u> AM</span>
                            <span class="n ord @Ord("az")" title="Cartões azuis (clique para ordenar)" @onclick='() => Ordenar("az")'><u class="cart az"></u> AZ</span>
                            <span class="n ord @Ord("vm")" title="Cartões vermelhos (clique para ordenar)" @onclick='() => Ordenar("vm")'><u class="cart vm"></u> VM</span>
                            <span class="n ord @Ord("med")" title="Média de gols por jogo (clique para ordenar)" @onclick='() => Ordenar("med")'>MÉD.</span>
                            <span class="n ord @Ord("ast")" title="Assistências (clique para ordenar)" @onclick='() => Ordenar("ast")'>AST.</span>
                            <span class="n ord @Ord("gc")" title="Gols contra (clique para ordenar)" @onclick='() => Ordenar("gc")'>G.C.</span>
                            <span class="gols ord @Ord("gols")" title="Gols (clique para ordenar)" @onclick='() => Ordenar("gols")'>GOLS</span>
                        </div>
                    }
                    <ol class="hist-lista @(EhTemporadaAtual ? "com-stats" : "")">
                        @foreach (var l in tabela)
                        {
                            var r = ResumoDe(l, porAtleta);
                            <li class="@(l.Posicao <= 3 ? "top" + l.Posicao : "")">
                                <span class="pos">@l.Posicao</span>
                                <span class="nome">@l.Nome @if (!l.Ativo){<em>inativo</em>}</span>
                                @if (EhTemporadaAtual)
                                {
                                    <span class="n">@(r is null ? "–" : r.JogosVermelho.ToString())</span>
                                    <span class="n">@(r is null ? "–" : r.JogosAmarelo.ToString())</span>
                                    <span class="n">@(r is null ? "–" : r.Amarelos.ToString())</span>
                                    <span class="n">@(r is null ? "–" : r.Azuis.ToString())</span>
                                    <span class="n">@(r is null ? "–" : r.Vermelhos.ToString())</span>
                                    <span class="n med">@MediaTexto(l, r)</span>
                                    <span class="n">@(r is null ? "–" : r.Assistencias.ToString())</span>
                                    <span class="n gc">@(r is null ? "–" : r.GolsContra.ToString())</span>
                                }
                                <span class="gols">@l.Gols</span>
                            </li>
                        }
                    </ol>
                    @if (Aba == 0 && outrosGeral > 0)
                    {
                        <p class="hist-nota">O total geral inclui @outrosGeral gols sem ano definido (coluna "Gols Outros" da planilha).</p>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    List<HistoricoArtilheiro> jogadores = new();
    List<HistoricoGol> gols = new();
    List<int> anos = new();
    bool carregando = true;
    string? erro;
    string busca = "";
    string filtro = "todos";
    int aba = DateTime.Now.Year;   // sempre abre na temporada atual
    bool primeiraCarga = true;
    const int MinJogosMedia = 5;
    static readonly CultureInfo PtBr = new("pt-BR");
    Dictionary<int, List<ResumoTemporada>> resumos = new();
    int Aba
    {
        get => aba;
        set { if (aba == value) return; aba = value; _ = CarregarResumoAsync(value); }
    }
    int totalGols => Linhas.Sum(l => l.Gols);
    int outrosGeral => jogadores.Sum(j => j.GolsOutros ?? 0);

    protected override async Task OnInitializedAsync() => await Carregar();

    async Task Carregar()
    {
        carregando = true; erro = null;
        try
        {
            (jogadores, gols) = await Servico.CarregarAsync();
            try { pelada = await Servico.CarregarPeladaAsync(); peladaOk = true; }
            catch { peladaOk = false; }
            anos = gols.Where(g => g.Ano.HasValue).Select(g => g.Ano!.Value).Distinct().OrderByDescending(a => a).ToList();
            if (primeiraCarga)
            {
                primeiraCarga = false;
                if (!anos.Contains(aba)) aba = anos.FirstOrDefault();
            }
        }
        catch (Exception ex) { erro = "Não foi possível carregar o histórico: " + ex.Message; }
        carregando = false;
        await CarregarResumoAsync(aba);
    }

    // "Ativo" aqui significa: joga na pelada (flag joga_pelada, marcado no admin). Não é o ativo do Cartola.
    // Se a leitura falhar, cai no flag antigo para não zerar a lista.
    Dictionary<long, bool> pelada = new();
    bool peladaOk;

    bool JogaNaPelada(HistoricoArtilheiro j) => peladaOk ? pelada.GetValueOrDefault(j.JogadorId) : j.Ativo;

    // Jogos, média e cartões vêm do resumo da temporada. Se a leitura falhar, os cartões mostram "—".
    async Task CarregarResumoAsync(int ano)
    {
        if (ano != DateTime.Now.Year || resumos.ContainsKey(ano)) { StateHasChanged(); return; }
        try { resumos[ano] = await ServicoTemp.ResumoAsync(ano); }
        catch { resumos[ano] = new(); }
        StateHasChanged();
    }

    // Estatísticas (jogos por time, cartões, média) existem só para a temporada atual.
    bool EhTemporadaAtual => Aba == DateTime.Now.Year;

    List<ResumoTemporada> ResumoAtual => resumos.TryGetValue(Aba, out var r) ? r : new();
    record Destaque(string Nome, string Valor);
    static readonly Destaque SemDado = new("—", "—");

    List<LinhaRanking> Top3 => Ranking(false).Where(l => l.Posicao <= 3).Take(3).ToList();

    Destaque EstMaisGols
    {
        get
        {
            var r = Ranking(false);
            if (r.Count == 0) return SemDado;
            var topo = r.Where(l => l.Gols == r[0].Gols).ToList();
            return new Destaque(Nomes(topo.Select(t => t.Nome)), r[0].Gols.ToString());
        }
    }

    Destaque EstMedia => Melhor(ResumoAtual.Where(x => x.Jogos >= MinJogosMedia),
        x => (double)x.Gols / x.Jogos, v => v.ToString("0.0", PtBr));
    Destaque EstJogos => Melhor(ResumoAtual, x => x.Jogos, v => ((int)v).ToString());
    Destaque EstCartoes => Melhor(ResumoAtual, x => x.Amarelos + x.Azuis + x.Vermelhos, v => ((int)v).ToString());
    Destaque EstAssistencias => Melhor(ResumoAtual, x => x.Assistencias, v => ((int)v).ToString());
    Destaque EstGolsContra => Melhor(ResumoAtual, x => x.GolsContra, v => ((int)v).ToString());

    static Destaque Melhor(IEnumerable<ResumoTemporada> fonte, Func<ResumoTemporada, double> valor, Func<double, string> fmt)
    {
        var l = fonte.Select(x => (x.Nome, V: valor(x))).Where(x => x.V > 0).OrderByDescending(x => x.V).ToList();
        if (l.Count == 0) return SemDado;
        var topo = l.Where(x => Math.Abs(x.V - l[0].V) < 1e-9).Select(x => x.Nome);
        return new Destaque(Nomes(topo), fmt(l[0].V));
    }

    static string Nomes(IEnumerable<string> nomes)
    {
        var l = nomes.OrderBy(n => n).ToList();
        return l.Count <= 2 ? string.Join(", ", l) : l[0] + " +" + (l.Count - 1);
    }


    Dictionary<Guid, ResumoTemporada> ResumoPorAtleta =>
        ResumoAtual.GroupBy(x => x.AtletaId).ToDictionary(g => g.Key, g => g.First());

    ResumoTemporada? ResumoDe(LinhaRanking l, Dictionary<Guid, ResumoTemporada> porAtleta)
    {
        if (!EhTemporadaAtual) return null;
        var atletaId = jogadores.FirstOrDefault(j => j.JogadorId == l.JogadorId)?.AtletaId;
        return atletaId.HasValue && porAtleta.TryGetValue(atletaId.Value, out var r) ? r : null;
    }

    static string MediaTexto(LinhaRanking l, ResumoTemporada? r) =>
        r is null || r.Jogos <= 0 ? "–" : ((double)l.Gols / r.Jogos).ToString("0.0", PtBr);

    List<LinhaRanking> Linhas => Ranking(true);

    // ---- Ordenação da tabela (só na temporada atual, onde existem as estatísticas) ----
    // Primeiro clique em uma coluna ordena do maior para o menor; clicar de novo inverte.
    string ordem = "gols";
    bool ordemDesc = true;

    void Ordenar(string chave)
    {
        if (!EhTemporadaAtual) return;
        if (ordem == chave) ordemDesc = !ordemDesc;
        else { ordem = chave; ordemDesc = true; }
    }

    string Ord(string chave) => EhTemporadaAtual && ordem == chave ? (ordemDesc ? "on" : "on asc") : "";

    // Jogadores sem resumo na temporada (null) ficam sempre no fim, em qualquer direção.
    double? ValorOrdem(LinhaRanking l, ResumoTemporada? r)
    {
        if (ordem == "gols") return l.Gols;
        if (r is null) return null;
        return ordem switch
        {
            "v" => r.JogosVermelho,
            "a" => r.JogosAmarelo,
            "am" => r.Amarelos,
            "az" => r.Azuis,
            "vm" => r.Vermelhos,
            "ast" => r.Assistencias,
            "gc" => r.GolsContra,
            "med" => r.Jogos > 0 ? (double)l.Gols / r.Jogos : (double?)null,
            _ => l.Gols
        };
    }

    // Linhas na ordem escolhida. A posição (#) acompanha o critério: empates dividem a mesma posição.
    // Cards (artilheiro, totais) continuam usando Linhas, sempre por gols.
    List<LinhaRanking> LinhasTabela(Dictionary<Guid, ResumoTemporada> porAtleta)
    {
        var baseL = Linhas;
        if (!EhTemporadaAtual || (ordem == "gols" && ordemDesc)) return baseL;

        var q = baseL.Select(l => (L: l, V: ValorOrdem(l, ResumoDe(l, porAtleta)))).ToList();
        var ord = (ordemDesc
                ? q.OrderBy(x => x.V is null).ThenByDescending(x => x.V ?? 0)
                : q.OrderBy(x => x.V is null).ThenBy(x => x.V ?? 0))
            .ThenByDescending(x => x.L.Gols).ThenBy(x => x.L.Nome)
            .ToList();

        return ord.Select(x => x.L with
        {
            Posicao = 1 + ord.Count(y => y.V is not null && (x.V is null || y.V > x.V))
        }).ToList();
    }

    List<LinhaRanking> Ranking(bool aplicarFiltros)
    {
        {
            // Todos os jogadores entram; quem não fez gol no ano fica com 0 (só aparece se tiver participação, abaixo).
            var golsAno = Aba == 0 ? null : gols.Where(g => g.Ano == Aba)
                .GroupBy(g => g.JogadorId).ToDictionary(g => g.Key, g => g.Sum(x => x.Gols));
            IEnumerable<(HistoricoArtilheiro J, int G)> basico = Aba == 0
                ? jogadores.Select(j => (j, j.Total ?? 0))
                : jogadores.Select(j => (j, golsAno!.GetValueOrDefault(j.JogadorId)));

            // Na tabela da temporada atual, quem só tem assistência ou gol contra também aparece (com 0 gols).
            var porAtleta = aplicarFiltros && EhTemporadaAtual ? ResumoPorAtleta : null;
            bool Participou(HistoricoArtilheiro j) =>
                porAtleta is not null && j.AtletaId is Guid id && porAtleta.TryGetValue(id, out var r)
                && (r.Assistencias > 0 || r.GolsContra > 0);

            var q = basico.Where(x => x.G > 0 || Participou(x.J));
            if (aplicarFiltros && filtro == "ativos") q = q.Where(x => JogaNaPelada(x.J));
            if (aplicarFiltros && filtro == "inativos") q = q.Where(x => !JogaNaPelada(x.J));
            if (aplicarFiltros && !string.IsNullOrWhiteSpace(busca))
                q = q.Where(x => x.J.Nome.Contains(busca.Trim(), StringComparison.OrdinalIgnoreCase));

            var lista = q.OrderByDescending(x => x.G).ThenBy(x => x.J.Nome).ToList();
            var res = new List<LinhaRanking>();
            for (int i = 0; i < lista.Count; i++)
            {
                int pos = i > 0 && lista[i].G == lista[i - 1].G ? res[i - 1].Posicao : i + 1;
                res.Add(new LinhaRanking(pos, lista[i].J.JogadorId, lista[i].J.Nome, JogaNaPelada(lista[i].J), lista[i].G, null));
            }
            return res;
        }
    }
}

