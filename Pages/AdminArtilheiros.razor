        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(86px, 1fr));
        gap: .5rem;
    }

        .ha-anos label {
            margin: 0;
        }

            .ha-anos label span {
                font-size: .75rem;
                opacity: .75;
            }

