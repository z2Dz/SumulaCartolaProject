        }

    .ha-rodape {
        display: flex;
        gap: .5rem;
        margin-top: 1rem;
    }

    .ha-juntar {
        margin-top: 1.2rem;
        padding-top: .8rem;
        border-top: 1px dashed rgba(80,200,180,.3);
        font-size: .85rem;
    }

        .ha-juntar div {
            display: flex;
            gap: .5rem;
            margin-top: .4rem;
        }

        .ha-juntar select {
            flex: 1;
            min-width: 0;
        }

    .ha-voltar {
        display: none;
        align-self: flex-start;
        margin-bottom: .6rem;
        background: none;
        border: 0;
        color: inherit;
        cursor: pointer;
        padding: 0;
    }

    @@media (max-width: 899px) {
        .ha-corpo {
            grid-template-columns: 1fr;
        }

        .ha.editando .ha-lista-col {
            display: none;
        }

        .ha:not(.editando) .ha-ed {
            display: none;
        }

        .ha-voltar {
            display: block;
        }
    }
</style>
